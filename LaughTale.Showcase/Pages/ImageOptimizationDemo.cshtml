@page "/ImageOptimizationDemo"
@model LaughTale.Showcase.Pages.ImageOptimizationDemoModel
@{
    ViewData["Title"] = "Image Optimization";
}

<div class="app-container" style="max-width: 900px; display: flex; flex-direction: column; gap: 2rem; padding-bottom: 3rem;">

    <div style="background: linear-gradient(135deg, var(--p-surface-0) 0%, var(--p-surface-50) 100%); border: 1px solid var(--p-border-color); border-radius: 1.25rem; padding: 2.5rem 2rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);">
        <h1 style="font-size: 1.875rem; font-weight: 800; color: var(--p-text-color); margin: 0;">Image Optimization</h1>
        <p style="color: var(--p-text-muted); font-size: 0.875rem; margin: 0.25rem 0 0;">
            ROADMAP.v5.md Part H: add <code>lt-optimize</code> to a plain <code>&lt;img&gt;</code> tag.
            No image-processing dependency, no build step - <code>ImageDimensionReader</code> parses
            the file's own PNG/GIF/JPEG header (the same "read straight from the real file" approach
            <code>lt-integrity</code>'s SRI hashing already uses) and stamps real
            <code>width</code>/<code>height</code> automatically, the single biggest Cumulative Layout
            Shift fix an image can get. View source to see the attributes this page never wrote by hand.
        </p>
    </div>

    <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem;">
        <h2 style="font-size: 1.05rem; font-weight: 700; color: var(--p-text-color); margin: 0;">Below the fold - lazy by default</h2>
        <p style="color: var(--p-text-muted); font-size: 0.8125rem; margin: 0;">
            No <code>width</code>/<code>height</code>/<code>loading</code> written in this page's
            markup - all three are stamped automatically. Real 800×400 local PNG.
        </p>
        <img lt-optimize src="/images/demo/hero.png" alt="Gradient hero banner demonstrating automatic width/height/loading" style="max-width: 100%; border-radius: 0.75rem; display: block;" />
    </div>

    <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem;">
        <h2 style="font-size: 1.05rem; font-weight: 700; color: var(--p-text-color); margin: 0;">Above the fold - <code>lt-priority</code></h2>
        <p style="color: var(--p-text-muted); font-size: 0.8125rem; margin: 0;">
            Matches Next.js's own <code>&lt;Image priority&gt;</code> convention: skips
            <code>loading="lazy"</code> and adds <code>fetchpriority="high"</code> for critical,
            above-the-fold content that shouldn't defer.
        </p>
        <img lt-optimize lt-priority src="/images/demo/hero.png" alt="Same banner, marked high-priority" style="max-width: 100%; border-radius: 0.75rem; display: block;" />
    </div>

</div>
