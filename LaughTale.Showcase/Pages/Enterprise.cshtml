<style>
.component-card {
    background: var(--p-surface-0);
    border: 1px solid var(--p-border-color);
    border-radius: var(--p-border-radius-xl);
    box-shadow: var(--p-shadow-sm);
    padding: 1.75rem;
    margin-bottom: 2rem;
    display: none;
}
.component-card.active-card {
    display: block !important;
}
.component-card .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--p-border-color);
    padding-bottom: 1rem;
}
.component-card .card-header h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--p-text-color);
    margin: 0;
}
.component-card .card-header p {
    font-size: 0.875rem;
    color: var(--p-text-muted);
    margin: 0.35rem 0 0;
}
</style>

<script>
(function() {
    function showTabSection(targetId) {
        if (!targetId || targetId === '#' || targetId === '/enterprise') {
            targetId = 'sec-dynamic-form';
        }
        let id = targetId.replace(/^.*#/, '').trim() || 'sec-dynamic-form';
        if (id === 'sec-chips') id = 'sec-inputtags';
        const allCards = document.querySelectorAll('.enterprise-sections > section');
        if (!allCards || !allCards.length) return;

        let matched = false;
        allCards.forEach(card => {
            if (card.id === id) {
                card.style.display = 'block';
                card.classList.add('active-card');
                matched = true;
            } else {
                card.style.display = 'none';
                card.classList.remove('active-card');
            }
        });

        if (!matched && allCards[0]) {
            allCards[0].style.display = 'block';
            allCards[0].classList.add('active-card');
        }

        // Highlight active link in sidebar
        document.querySelectorAll('aside a, [data-sidebar-link]').forEach(link => {
            const href = link.getAttribute('href') || '';
            if (href.endsWith('#' + id)) {
                link.classList.add('active');
            } else {
                link.classList.remove('active');
            }
        });

        window.dispatchEvent(new Event('resize'));
    }

    // Intercept clicks on links
    document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (!link) return;
        const href = link.getAttribute('href') || '';
        if (href.includes('#sec-')) {
            const hash = href.substring(href.indexOf('#'));
            e.preventDefault();
            history.pushState(null, '', hash);
            showTabSection(hash);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });

    window.addEventListener('hashchange', function() {
        showTabSection(window.location.hash);
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            showTabSection(window.location.hash);
        });
    } else {
        showTabSection(window.location.hash);
    }
})();
</script>
