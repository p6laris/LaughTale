                    <input type="text" placeholder="Right" p-tooltip.right="Right" class="p-inputtext p-component" style="padding: 0.55rem 0.85rem; font-size: 0.875rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color); background: var(--p-surface-0); color: var(--p-text-color); width: 8rem;" />
                    <input type="text" placeholder="Top" p-tooltip.top="Top" class="p-inputtext p-component" style="padding: 0.55rem 0.85rem; font-size: 0.875rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color); background: var(--p-surface-0); color: var(--p-text-color); width: 8rem;" />
                    <input type="text" placeholder="Bottom" p-tooltip.bottom="Bottom" class="p-inputtext p-component" style="padding: 0.55rem 0.85rem; font-size: 0.875rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color); background: var(--p-surface-0); color: var(--p-text-color); width: 8rem;" />
                    <input type="text" placeholder="Left" p-tooltip.left="Left" class="p-inputtext p-component" style="padding: 0.55rem 0.85rem; font-size: 0.875rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color); background: var(--p-surface-0); color: var(--p-text-color); width: 8rem;" />
                </div>
            </div>

            <!-- Demo 3: Delay -->
            <div data-tooltip-demo="delay" style="background: var(--p-surface-50); padding: 1.5rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Delay</h3>
