            <div>
                <h2>Tooltip</h2>
                <p>Tooltip directive provides advisory information for a component. Tooltip is integrated within various PrimeVue components.</p>
            </div>
            <span class="aura-tag tag-emerald">Overlays</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Demo 1: Basic -->
            <div data-tooltip-demo="basic" style="background: var(--p-surface-50); padding: 1.5rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Basic</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Tooltip is applied to an element with v-tooltip directive where the value of the directive defines the text of the tooltip.</p>
                <div style="display: flex; justify-content: center; align-items: center; min-height: 3.5rem;">
                    <input type="text" placeholder="Username" p-tooltip.right="Enter your username" class="p-inputtext p-component" style="padding: 0.55rem 0.85rem; font-size: 0.875rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color); background: var(--p-surface-0); color: var(--p-text-color); width: 14rem;" />
                </div>
