                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Disabled</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.5rem;">When disabled is present, the slider cannot be edited or focused.</p>
                <div style="max-width: 240px; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem; padding: 0.5rem 0;">
                    <div>
                        <h5 style="margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: var(--p-text-color);">Disabled Slider</h5>
                        <island-slider value="50" disabled="true" />
                    </div>
                    <div>
                        <h5 style="margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: var(--p-text-color);">Disabled All Handles</h5>
                        <island-slider range="true" value="20" max-value="80" disabled="true" />
                    </div>
                    <div>
                        <h5 style="margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600; color: var(--p-text-color);">Disabled Single Handle</h5>
                        <island-slider range="true" value="20" max-value="80" disabled-min-handle="true" />
                    </div>
                </div>
            </div>

            <!-- Demo 7: Value Change Events -->
            <div style="background: var(--p-surface-50); padding: 1.5rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Value Change Events</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.5rem;">The <code style="font-family: var(--p-font-mono);">change</code> event is triggered during drag, while <code style="font-family: var(--p-font-mono);">slideend</code> is fired when drag completes.</p>
                <div style="max-width: 240px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1rem; padding: 0.5rem 0;">
                    <div style="font-family: var(--p-font-mono); font-size: 0.875rem; color: var(--p-text-muted);">change: <span id="change-value-display" style="font-weight: 700; color: var(--p-text-color);">50</span></div>
                    <div style="font-family: var(--p-font-mono); font-size: 0.875rem; color: var(--p-text-muted);">slideend: <span id="slideend-value-display" style="font-weight: 700; color: var(--p-text-color);">50</span></div>
                    <div style="width: 100%; margin-top: 0.5rem;">
                        <island-slider input-id="slider-event-demo" value="50" min="0" max="100" />
                    </div>
                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const slEl = document.getElementById('slider-event-demo');
                            const valEl = document.getElementById('change-value-display');
                            const endEl = document.getElementById('slideend-value-display');
                            if (slEl) {
                                slEl.addEventListener('slider:change', (e) => {
                                    if (valEl) valEl.textContent = e.detail.value;
                                });
                                slEl.addEventListener('slider:slideend', (e) => {
                                    if (endEl) endEl.textContent = e.detail.value;
                                });
                            }
                        });
                    </script>
                </div>
            </div>
        </div>
    </section>

