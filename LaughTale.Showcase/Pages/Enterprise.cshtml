    <section id="sec-slider" class="component-card">
        <div class="card-header">
            <div>
                <h2>Slider</h2>
                <p>Slider is a component to provide numerical input by dragging a handle along a continuous or discrete stepped track.</p>
            </div>
            <span class="aura-tag tag-indigo">Form Control</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Demo 1: Basic Slider -->
            <div style="background: var(--p-surface-50); padding: 1.5rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
