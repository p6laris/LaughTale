@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = currentCulture.TextInfo.IsRightToLeft || currentCulture.Name.StartsWith("ku") || currentCulture.Name.StartsWith("ckb");
}
<!DOCTYPE html>
<html lang="@currentCulture.Name" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaughTale</title>
    <!-- Google Fonts: Inter (Tailwind CSS default), Geist, Plus Jakarta Sans, Outfit, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Aura-Inspired Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Synchronous theme initialization (prevents flash)
        const savedTheme = localStorage.getItem('theme');
        const isDark = savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
        } else {
            document.documentElement.setAttribute('data-theme', 'light');
        }
    </script>
</head>
<body style="margin: 0; padding: 0; background: var(--p-surface-50); color: var(--p-text-color); font-family: var(--p-font-family, sans-serif);">

    <!-- Global Theme Studio Island Drawer -->
    <island-theme-studio />

    <!-- Full-Height App Shell Layout -->
    <div class="app-shell" style="display: flex; min-height: 100vh; width: 100%;">

        <!-- Left Full-Height Sidebar (Sticky Top: 0, 100vh) -->
        <aside class="app-sidebar-dock" style="position: sticky; top: 0; height: 100vh; z-index: 40; flex-shrink: 0;">
            <island-sidebar items="@LaughTale.Showcase.Services.NavigationData.GetGlobalSidebarItems(Context.Request.Path)" title="LaughTale Aura" />
        </aside>

        <!-- Right Main Viewport Area -->
        <div class="app-viewport" style="flex: 1; min-width: 0; display: flex; flex-direction: column; min-height: 100vh;">
            
            <!-- Top App Header Bar with Demo-style Sidebar Trigger and Aura Breadcrumb -->
            <header class="app-header" style="position: sticky; top: 0; z-index: 50; height: 60px; background: var(--p-surface-0); border-bottom: 1px solid var(--p-border-color); display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; box-sizing: border-box;">
                <div style="display: flex; align-items: center; gap: 0.85rem;">
                    <!-- Demo-matching Sidebar Trigger Button -->
                    <button type="button" 
                            class="p-sidebar-trigger" 
                            onclick="document.dispatchEvent(new CustomEvent('app-sidebar:toggle'))" 
                            title="Toggle Sidebar Navigation" 
                            aria-label="Toggle navigation"
                            style="display: inline-flex; align-items: center; justify-content: center; width: 2.1rem; height: 2.1rem; border-radius: 6px; border: 1px solid var(--p-border-color); background: transparent; color: var(--p-text-muted); cursor: pointer; transition: background 0.15s ease, color 0.15s ease;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
                    </button>

                    <!-- LaughTale Aura Breadcrumb Navigation -->
                    <nav class="p-breadcrumb p-breadcrumb-transparent" aria-label="Breadcrumb" style="background: transparent; border: none; padding: 0;">
                        <ol class="p-breadcrumb-list" style="display: flex; align-items: center; gap: 0.35rem; margin: 0; padding: 0; list-style: none;">
                            <li class="p-breadcrumb-item">
                                <a href="/" class="p-breadcrumb-item-link" title="Showcase Home" style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--p-text-muted); text-decoration: none; font-size: 0.8125rem; font-weight: 500; direction: ltr;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                    <span>Home</span>
                                </a>
                            </li>
                            <li class="p-breadcrumb-separator" style="color: var(--p-surface-400); display: inline-flex; align-items: center;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(isRtl ? "transform: scaleX(-1);" : "")"><polyline points="9 18 15 12 9 6"/></svg>
                            </li>
                            <li class="p-breadcrumb-item">
                                <a href="/components" class="p-breadcrumb-item-link" style="color: var(--p-text-muted); text-decoration: none; font-size: 0.8125rem; font-weight: 500; direction: ltr;">
                                    <span>Components</span>
                                </a>
                            </li>
                            <li class="p-breadcrumb-separator" style="color: var(--p-surface-400); display: inline-flex; align-items: center;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(isRtl ? "transform: scaleX(-1);" : "")"><polyline points="9 18 15 12 9 6"/></svg>
                            </li>
                            <li class="p-breadcrumb-item">
                                <span class="p-breadcrumb-item-link p-breadcrumb-item-current" style="color: var(--p-text-color); font-weight: 600; font-size: 0.8125rem;" aria-current="page">
                                    @ViewData["Title"]
                                </span>
                            </li>
                        </ol>
                    </nav>
                </div>

                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <!-- Global Theme Studio Trigger Button -->
                    <button type="button" 
                            onclick="document.dispatchEvent(new CustomEvent('studio:open'))" 
                            class="p-button p-button-primary" 
                            style="direction: ltr; padding: 0.35rem 0.75rem; font-size: 0.8125rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; line-height: 1;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-shrink: 0;"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
                        <span style="display: inline-flex; align-items: center; line-height: 1;">Studio</span>
                    </button>

                    <!-- Kurdish / Language & RTL Switcher -->
                    <button type="button" 
                            onclick="const isKu = document.documentElement.lang.startsWith('ku') || document.documentElement.lang.startsWith('ckb'); const targetLang = isKu ? 'en-US' : 'ku'; const targetDir = isKu ? 'ltr' : 'rtl'; document.documentElement.lang = targetLang; document.documentElement.dir = targetDir; document.cookie = `.AspNetCore.Culture=c=${targetLang}|uic=${targetLang}; path=/; max-age=31536000; SameSite=Lax`; window.location.reload();" 
                            class="p-button p-button-secondary" 
                            style="direction: ltr; padding: 0.35rem 0.65rem; font-size: 0.8125rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; font-weight: 600; line-height: 1;"
                            title="Toggle Language & RTL (کوردی / English)">
                        <span style="display: inline-flex; align-items: center; line-height: 1; font-size: 0.875rem;">@(isRtl ? "☀️" : "🇺🇸")</span>
                        <span style="display: inline-flex; align-items: center; line-height: 1; font-family: var(--p-font-family, sans-serif);">@(isRtl ? "کوردی" : "EN")</span>
                    </button>

                    <!-- Dark Mode Toggle Button -->
                    <button type="button" 
                            onclick="document.documentElement.classList.toggle('dark'); const isDark = document.documentElement.classList.contains('dark'); document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light'); localStorage.setItem('theme', isDark ? 'dark' : 'light');" 
                            class="p-button p-button-secondary" 
                            style="padding: 0.35rem 0.65rem; font-size: 0.8125rem; display: inline-flex; align-items: center; justify-content: center; line-height: 1;"
                            title="Toggle Dark Mode">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-shrink: 0;"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                    </button>

                    <!-- Persistent Island across View Transitions -->
                    <div>
                        <island name="persistent-telemetry" 
                                props="@(new SystemTelemetryProps("API Gateway", 3))" 
                                persist="telemetry-widget" 
                                hydrate="Load" />
                    </div>
                </div>
            </header>

            <!-- Main Page Content Body -->
            <main class="app-main-body" style="flex: 1; padding: 2rem 2.5rem 4rem; width: 100%; box-sizing: border-box; max-width: 1400px; margin: 0 auto;">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Load Islands Bundle -->
    <script type="module" src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
