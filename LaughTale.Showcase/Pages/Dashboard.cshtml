@page "/dashboard"
@model LaughTale.Showcase.Pages.DashboardModel
@{
    ViewData["Title"] = "Enterprise Telemetry Dashboard & Mission Control";
}

<div class="app-container" style="max-width: 1320px; display: flex; flex-direction: column; gap: 2rem; padding-bottom: 3rem;">
    
    <!-- Top Action Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.5rem 2rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.25rem;">
                <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; color: var(--p-text-color); margin: 0;">Enterprise Mission Control</h1>
                <span class="aura-tag tag-emerald">Cluster 10 &bull; Healthy</span>
            </div>
            <p style="color: var(--p-text-muted); font-size: 0.875rem; margin: 0;">Real-time node telemetry, cryptographic audit logs, and hardware capacity metrics.</p>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <!-- Command Palette Trigger Button -->
            <button type="button" 
                    onclick="document.dispatchEvent(new CustomEvent('command:open'))" 
                    class="p-button p-button-secondary" 
                    style="padding: 0.45rem 0.85rem; font-size: 0.8125rem;">
                🔍 Spotlight <kbd style="font-family: monospace; background: var(--p-surface-200); padding: 1px 5px; border-radius: 4px; font-size: 0.6875rem; margin-left: 0.35rem;">Ctrl+K</kbd>
            </button>

            <!-- TweakAura Studio Trigger -->
            <button type="button" 
                    onclick="document.dispatchEvent(new CustomEvent('studio:open'))" 
                    class="p-button p-button-primary" 
                    style="padding: 0.45rem 1rem; font-size: 0.8125rem;">
                🎨 Theme Studio
            </button>
        </div>
    </div>

    <!-- 4 Radial KPI Meters -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
        
        <!-- KPI 1: Active Concurrency -->
        <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
            <div>
                <div style="font-size: 0.75rem; font-weight: 700; color: var(--p-text-muted); text-transform: uppercase;">Active Concurrency</div>
                <div style="font-size: 1.75rem; font-weight: 800; color: var(--p-text-color); margin: 0.35rem 0;">4,892 <span style="font-size: 0.75rem; color: #10b981; font-weight: 600;">+14%</span></div>
                <div style="font-size: 0.75rem; color: var(--p-text-muted);">Active HTTP Sessions</div>
            </div>
            <island-knob value="78" min="0" max="100" size="64" value-color="#10b981" hydrate="Load" />
        </div>

        <!-- KPI 2: Gateway Latency -->
        <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
            <div>
                <div style="font-size: 0.75rem; font-weight: 700; color: var(--p-text-muted); text-transform: uppercase;">p99 Gateway Latency</div>
                <div style="font-size: 1.75rem; font-weight: 800; color: var(--p-text-color); margin: 0.35rem 0;">1.42 <span style="font-size: 0.875rem; font-weight: 500;">ms</span></div>
                <div style="font-size: 0.75rem; color: #10b981; font-weight: 600;">Sub-millisecond edge</div>
            </div>
            <island-knob value="94" min="0" max="100" size="64" value-color="#3b82f6" hydrate="Load" />
        </div>

        <!-- KPI 3: Cache Hit Ratio -->
        <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
            <div>
                <div style="font-size: 0.75rem; font-weight: 700; color: var(--p-text-muted); text-transform: uppercase;">OutputCache Efficiency</div>
                <div style="font-size: 1.75rem; font-weight: 800; color: var(--p-text-color); margin: 0.35rem 0;">99.4%</div>
                <div style="font-size: 0.75rem; color: var(--p-text-muted);">Cache leak guard active</div>
            </div>
            <island-knob value="99" min="0" max="100" size="64" value-color="#a855f7" hydrate="Load" />
        </div>

        <!-- KPI 4: Security Shield -->
        <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
            <div>
                <div style="font-size: 0.75rem; font-weight: 700; color: var(--p-text-muted); text-transform: uppercase;">Zero-Trust Engine</div>
                <div style="font-size: 1.25rem; font-weight: 800; color: #10b981; margin: 0.35rem 0;">HSM Token Guard</div>
                <div style="font-size: 0.75rem; color: var(--p-text-muted);">XSS &amp; Prototype Safe</div>
            </div>
            <div style="font-size: 2rem; color: #10b981;">🛡️</div>
        </div>

    </div>

    <!-- System Resource Allocation MeterGroup -->
    <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.75rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <div>
                <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--p-text-color); margin: 0;">Multi-Core Cluster Resource Distribution</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin: 0.25rem 0 0;">Dynamic thread pool allocation across Erbil and Frankfurt regional instances.</p>
            </div>
            <span class="p-tag p-tag-info">Segmented Meter</span>
        </div>
        <island-meter-group values="@Model.SystemHealthMeters" max="100" hydrate="Load" />
    </div>

    <!-- Security Audit Trail DataTable -->
    <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.75rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
            <div>
                <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--p-text-color); margin: 0;">Cryptographic Audit Trail</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin: 0.25rem 0 0;">Immutable telemetry logs verified across distributed nodes.</p>
            </div>
            <button type="button" class="p-button p-button-secondary" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">
                Export Audit Log (CSV)
            </button>
        </div>

        <island-datatable value="@Model.AuditRows" 
                          paginator="true" 
                          rows="5" 
                          show-gridlines="true" 
                          striped-rows="true"
                          filter-display="row"
                          selection-mode="single"
                          hydrate="Load">
        </island-datatable>
    </div>

</div>
