@{
    Layout = "_Layout";
}

<div style="max-width: 1100px; display: flex; gap: 2rem; padding-bottom: 3rem;">

    <nav id="outlet-demo-sidebar" style="width: 220px; flex-shrink: 0; height: 420px; overflow-y: auto; background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.25rem;">
        <h2 style="font-size: 0.95rem; font-weight: 800; color: var(--p-text-color); margin: 0 0 1rem;">Demo Section</h2>
        <p style="font-size: 0.75rem; color: var(--p-text-muted); margin: 0 0 1rem;">
            This sidebar - and its own scroll position below - is OUTSIDE the outlet. It is never
            removed or recreated when navigating between the two demo pages.
        </p>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            <li><a href="/OutletDemoA">Outlet Demo A</a></li>
            <li><a href="/OutletDemoB">Outlet Demo B</a></li>
        </ul>
        <div style="height: 500px; margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--p-border-color); font-size: 0.75rem; color: var(--p-text-muted);">
            Scroll this sidebar down before clicking between the two pages, then confirm the scroll
            position survives navigation - filler content follows.
            <br /><br />
            (scroll marker) Line 1<br />(scroll marker) Line 2<br />(scroll marker) Line 3<br />
            (scroll marker) Line 4<br />(scroll marker) Line 5<br />(scroll marker) Line 6<br />
            (scroll marker) Line 7<br />(scroll marker) Line 8<br />(scroll marker) Line 9<br />
            (scroll marker) Line 10
        </div>
    </nav>

    <island-outlet name="demo-section" style="flex: 1; min-width: 0;">
        @RenderBody()
    </island-outlet>

</div>
