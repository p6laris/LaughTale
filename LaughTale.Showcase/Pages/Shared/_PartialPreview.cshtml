@model LaughTale.Showcase.Pages.PartialsModel

<div style="padding: 1.5rem; border: 1px solid var(--p-border-color); border-radius: 1rem; background: var(--p-surface-0);">
    <div style="font-size: 0.75rem; color: var(--p-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Selected item</div>
    <div style="font-size: 1.75rem; font-weight: 800; color: var(--p-text-color);">@Model.SelectedItemName</div>
    <div style="font-size: 0.8125rem; color: var(--p-text-muted); margin-top: 0.25rem;">Item #@Model.SelectedId</div>
</div>
