@page "/IslandCompiler"
@model LaughTale.Showcase.Pages.IslandCompilerModel
@{
    ViewData["Title"] = "Island Compiler";
}

<div class="app-container" style="max-width: 1100px; display: flex; flex-direction: column; gap: 2rem; padding-bottom: 3rem;">

    <!-- Header Banner -->
    <div style="background: linear-gradient(135deg, var(--p-surface-0) 0%, var(--p-surface-50) 100%); border: 1px solid var(--p-border-color); border-radius: 1.25rem; padding: 2.5rem 2rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
            <div style="width: 2.5rem; height: 2.5rem; border-radius: 10px; background: linear-gradient(135deg, var(--p-primary-500), var(--p-primary-700)); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800;">
                &#9881;
            </div>
            <div>
                <h1 style="font-size: 1.875rem; font-weight: 800; color: var(--p-text-color); margin: 0;">Island Compiler</h1>
                <p style="color: var(--p-text-muted); font-size: 0.875rem; margin: 0.25rem 0 0;">ROADMAP.v5.md Part B: a user-authored <code>Islands/UserCard.tsx</code> React component, discovered, type-mapped, and compiled into a real typed <code>&lt;island-user-card&gt;</code> TagHelper - no hand-written C# props record, no manual <code>defineIsland()</code> call.</p>
            </div>
        </div>

        <div style="margin-top: 1.25rem; padding: 0.75rem 1rem; background: var(--p-emerald-50, rgba(16, 185, 129, 0.1)); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 8px; font-size: 0.8125rem; color: #047857; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
            <span>&#9889; <strong>Pipeline:</strong> <code>Islands/UserCard.tsx</code> &rarr; <code>laughtale islands build</code> (Node discovery + esbuild bundling) &rarr; <code>islands.manifest.g.json</code> &rarr; <code>IslandGenerator</code> &rarr; this page's <code>&lt;island-user-card&gt;</code> tag.</span>
            <span class="p-tag p-tag-success" style="font-size: 0.7rem;">New</span>
        </div>
    </div>

    <!-- Live Islands -->
    <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.75rem;">
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--p-text-color); margin: 0 0 0.5rem;">Live UserCard Islands</h2>
        <p style="color: var(--p-text-muted); font-size: 0.8125rem; margin: 0 0 1.5rem;">
            Each card below is one <code>&lt;island-user-card&gt;</code> element, server-rendered with a <code>data-props</code> payload and hydrated on load (<code>hydrate="Load"</code>) by the same React island component, exercising every prop type the syntactic type-mapper supports: a required <code>string</code>, an optional <code>string</code>, an optional <code>boolean</code>, and an optional <code>number</code>.
        </p>

        <div style="display: flex; flex-direction: column; gap: 1rem;">

            <!-- All props set -->
            <island-user-card user-name="Ada Lovelace"
                               avatar-url="https://i.pravatar.cc/150?img=47"
                               is-online="true"
                               score="98"
                               hydrate="Load" />

            <!-- Optional props omitted: no avatar-url (falls back to initial avatar), no score line -->
            <island-user-card user-name="Grace Hopper"
                               is-online="false"
                               hydrate="Load" />

            <!-- Only the required prop plus score, no avatar -->
            <island-user-card user-name="Alan Turing"
                               score="76"
                               hydrate="Load" />

        </div>
    </div>

    <!-- Authoring Contract -->
    <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: 1rem; padding: 1.75rem; overflow-x: auto;">
        <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--p-text-color); margin: 0 0 1rem;">Source: Islands/UserCard.tsx</h2>
        <pre style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: 0.75rem; padding: 1rem 1.25rem; font-size: 0.8125rem; line-height: 1.6; overflow-x: auto; margin: 0;"><code>import { createReactAdapter } from 'laughtale/adapters/react';

export interface UserCardProps {
    userName: string;
    avatarUrl?: string;
    isOnline?: boolean;
    score?: number;
}

function UserCard({ userName, avatarUrl, isOnline, score }: UserCardProps) {
    return (/* ... */);
}

export default function UserCardIsland(container: HTMLElement, props: UserCardProps, ctx?: IslandContext) {
    return createReactAdapter(UserCard)(container, props, ctx);
}</code></pre>
        <p style="color: var(--p-text-muted); font-size: 0.75rem; margin: 0.85rem 0 0;">
            No <code>[Island]</code> attribute, no C# props record: <code>laughtale islands build</code> derives the <code>user-card</code> island name from the file path, maps <code>UserCardProps</code>'s members to <code>string</code>/<code>string?</code>/<code>bool?</code>/<code>double?</code>, and <code>IslandGenerator</code> emits the typed <code>IslandUserCardTagHelper</code> used above from that manifest alone.
        </p>
    </div>

</div>

@section Scripts {
    <!-- Served from LaughTale.Showcase.Islands via ASP.NET Core static web assets, not this
         project's own wwwroot - see LaughTale.Showcase.Islands.csproj's remarks for why the
         Islands/ folder has to live in a separate, already-compiled project. registry.js's own
         chunk imports are relative to ITS OWN URL, so no further path rewriting is needed. -->
    <script type="module" src="~/_content/LaughTale.Showcase.Islands/js/islands/registry.js" asp-append-version="true"></script>
}
