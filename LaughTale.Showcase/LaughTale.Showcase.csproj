<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ROADMAP.v5.md Part B: LaughTale.Generators is consumed here via ProjectReference (below),
       which NuGet's buildTransitive auto-import mechanism does not cover (it only fires for a real
       PackageReference). This explicit pair stands in for that auto-import - props early, targets
       late, mirroring exactly how the SDK itself sandwiches a project body between its own
       implicit Sdk.props/Sdk.targets imports. See LaughTale.Generators\buildTransitive\*.{props,targets}
       for the actual logic; this project's own Islands\ folder doesn't exist yet, so today this is
       inert (the targets' own Condition="Exists(...)" guards make that graceful). -->
  <Import Project="..\LaughTale.Generators\buildTransitive\LaughTale.Generators.props" Condition="Exists('..\LaughTale.Generators\buildTransitive\LaughTale.Generators.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LaughTale.Showcase</AssemblyName>
    <RootNamespace>LaughTale.Showcase</RootNamespace>
    <!-- ROADMAP.v5.md Part B verification aid: without this, Roslyn generator output (including
         IslandGenerator.Manifest.cs's manifest-driven TagHelpers) is compiled entirely in-memory
         and never written to disk anywhere in this repo - confirmed directly (no project sets
         either property, and the "obj/.../LaughTale.Generators/..." paths that appear in build
         warnings are virtual/diagnostic-only, backed by no real file). Enabled here so the
         generated <island-user-card> TagHelper source can actually be inspected on disk. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaughTale.Core\LaughTale.Core.csproj" />
    <ProjectReference Include="..\LaughTale.Components\LaughTale.Components.csproj" />
    <!-- ROADMAP.v5.md Part B end-to-end example: the actual <island-user-card> TagHelper and its
         static wwwroot/js/islands/* assets (exposed here via ASP.NET Core static web assets under
         /_content/LaughTale.Showcase.Islands/...) - see that project's own remarks for why this
         has to be a separate project rather than living directly in this one. -->
    <ProjectReference Include="..\LaughTale.Showcase.Islands\LaughTale.Showcase.Islands.csproj" />
    <ProjectReference Include="..\LaughTale.Generators\LaughTale.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- ROADMAP.v5.md Part H "Deployment presets": `dotnet publish` (unlike plain `dotnet build`, which
       nothing in this repo's own tooling had ever actually exercised before this pass - confirmed by
       hitting this for real) fails with NETSDK1152 ("multiple publish output files with the same
       relative path") because the SDK's default content glob picks up this project's own
       package.json/package-lock.json AND LaughTale.Showcase.Islands' identically-named files (via its
       ProjectReference's static web assets), both landing at the same output-relative path. Neither
       file has any purpose in a published web app - they're npm bookkeeping for the build step, which
       has already run by the time `dotnet publish` gets here. -->
  <ItemGroup>
    <Content Remove="package.json" />
    <Content Remove="package-lock.json" />
  </ItemGroup>

  <!-- Auto-bundle TypeScript islands before build -->
  <Target Name="BuildIslandsJs" BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsInputs;BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" Condition="Exists('$(ProjectDir)package.json')" />
    <!-- The SSR sidecar's server bundle is produced by the npm step above, so it is added here at
         execution time rather than by a static glob (which would miss it on a clean build). It sits
         outside wwwroot on purpose: server code that must never be served as a static asset. -->
    <ItemGroup>
      <None Include="ssr\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Import Project="..\LaughTale.Generators\buildTransitive\LaughTale.Generators.targets" Condition="Exists('..\LaughTale.Generators\buildTransitive\LaughTale.Generators.targets')" />

</Project>
