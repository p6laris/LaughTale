<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>LaughTale.Templates</PackageId>
    <Version>1.0.0</Version>
    <Title>LaughTale Project and Island Templates</Title>
    <Authors>LaughTale Team</Authors>
    <Description>Official dotnet new templates for LaughTale Islands Architecture web applications, custom islands, and component libraries.</Description>
    <PackageTags>dotnet-new;templates;islands;laughtale;razor;aspnetcore</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" PackagePath="content\" />
  </ItemGroup>

</Project>
