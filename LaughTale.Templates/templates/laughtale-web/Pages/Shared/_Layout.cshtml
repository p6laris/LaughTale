<!DOCTYPE html>
<html lang="en" data-theme="system">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaughTale Application</title>
    <link rel="stylesheet" href="/css/site.css" />
    <script type="module" src="/js/laughtale.js"></script>
</head>
<body style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: var(--p-surface-0, #ffffff); color: var(--p-surface-900, #0f172a); min-height: 100vh; display: flex; flex-direction: column;">
    <header style="border-bottom: 1px solid var(--p-surface-200, #e2e8f0); padding: 1rem 2rem; display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 1.5rem; font-weight: 800; background: linear-gradient(135deg, var(--p-primary-500, #10b981), #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">LaughTale</span>
            <span style="font-size: 0.75rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 9999px; background: var(--p-primary-50, #ecfdf5); color: var(--p-primary-700, #047857);">Islands Ready</span>
        </div>
        <nav style="display: flex; gap: 1.5rem;">
            <a href="/" style="color: inherit; text-decoration: none; font-weight: 500;">Home</a>
            <a href="/Privacy" style="color: inherit; text-decoration: none; font-weight: 500;">Privacy</a>
        </nav>
    </header>

    <main role="main" style="flex: 1; padding: 2rem;">
        @RenderBody()
    </main>

    <footer style="border-top: 1px solid var(--p-surface-200, #e2e8f0); padding: 1rem 2rem; font-size: 0.875rem; color: var(--p-surface-500, #64748b); text-align: center;">
        &copy; @DateTime.UtcNow.Year - LaughTale Islands Application
    </footer>

    <!-- Theme Studio Customizer Island -->
    <theme-studio-island default-open="false"></theme-studio-island>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
