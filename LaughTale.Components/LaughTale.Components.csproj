<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>LaughTale.Components</PackageId>
    <AssemblyName>LaughTale.Components</AssemblyName>
    <RootNamespace>LaughTale.Components</RootNamespace>
    <Description>Batteries-Included Enterprise UI Components for LaughTale (Stepper, Timeline, Camera, Dropzone, TreeSelect, DataGrid, Modal, Toast)</Description>
    <!-- ROADMAP.v5.md Part J: first-time trim analysis for this library, surfacing IL2026/IL3050/IL2091-class
         warnings from reflection-based JSON serialization and other trim-unsafe patterns during normal build. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaughTale.Core\LaughTale.Core.csproj" />
    <ProjectReference Include="..\LaughTale.Generators\LaughTale.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="GenerateIconSprite" BeforeTargets="BeforeBuild" Condition="Exists('..\scripts\gen-icons.mjs')">
    <Exec Command="node ..\scripts\gen-icons.mjs" ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

</Project>
