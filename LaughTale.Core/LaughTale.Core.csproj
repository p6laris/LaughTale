<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>LaughTale.Core</PackageId>
    <AssemblyName>LaughTale.Core</AssemblyName>
    <RootNamespace>LaughTale.Core</RootNamespace>
    <Description>High performance LaughTale Islands Architecture runtime and tag helpers for .NET 10</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
