<?xml version="1.0" encoding="utf-8"?>
<!--
  ROADMAP.v5.md Part H "Deployment presets" - IIS.

  Verified starting point: `dotnet publish` already generates a minimal, CORRECT web.config for
  in-process ANCM hosting on its own (SDK behavior, not something this repo had to build) - confirmed
  directly by running a real `dotnet publish` against LaughTale.Showcase and inspecting the output.
  This file is that same shape, with the production-relevant settings this preset's own investigation
  found worth being explicit about rather than left as invisible defaults - it is NOT a replacement
  for a different mechanism, it's the same one, annotated and tuned.

  Real finding worth recording: with `path="*"` mapped to the aspNetCore handler below, IIS's own
  static-file and HTTP-compression modules never get a chance to touch a response at all - EVERY
  request (including plain static assets under wwwroot) is proxied straight into the in-process
  ASP.NET Core pipeline, which is why LaughTale's own UseLaughTaleStaticAssetsCaching()/
  UseResponseCompression() (already shipped, see Part B/J) are what actually serve and compress every
  response under IIS too, unmodified - there is no IIS-side double-compression risk to guard against
  here, and no separate IIS-level caching config to write.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        hostingModel="inprocess": best throughput/latency (same worker process as IIS, no extra proxy
        hop) - the SDK's own default, kept here rather than switched to "outofprocess" without a
        reason to.

        stdoutLogEnabled="false" in production - flip to "true" (and point stdoutLogFile somewhere
        writable) only while diagnosing a startup failure; left on indefinitely, ANCM's own stdout
        redirection grows an unbounded log file.

        requestTimeout is deliberately NOT overridden here: this preset's own investigation found
        nothing in ANCM's in-process hosting that imposes an additional hard timeout beyond your own
        site/app-pool configuration - but if you use ROADMAP.v5.md Part E's out-of-order streaming
        feature with real production-scale delays (not this framework's own few-second demo values),
        verify that against your own site's `system.webServer/serverRuntime` and
        `system.web/httpRuntime executionTimeout` settings, which this file does not touch.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\LaughTale.Showcase.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
