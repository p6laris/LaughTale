<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>SoftMax.LaughTale.Markdown</PackageId>
    <AssemblyName>SoftMax.LaughTale.Markdown</AssemblyName>
    <RootNamespace>SoftMax.LaughTale.Markdown</RootNamespace>
    <Version>3.0.0</Version>
    <Authors>SoftMax</Authors>
    <Description>Markdig-powered Content Collections and Markdown processing with embedded Islands for SoftMax.LaughTale</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoftMax.LaughTale.Core\SoftMax.LaughTale.Core.csproj" />
  </ItemGroup>

</Project>
