<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ROADMAP.v5.md Part J "Publish honest numbers": a deliberately minimal LaughTale app - Home,
       an interactive Counter island, and a static Weather-style data page - matching the exact page
       shape `dotnet new blazor`/`dotnet new blazorwasm` scaffold by default, for a fair comparison.
       References LaughTale.Core only (not LaughTale.Components' 76-component library), since nothing
       here needs it - pulling that in would make this app's own weight unrepresentative of what a
       real "just the islands runtime + one counter" app actually ships. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LaughTale.Core\LaughTale.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json" />
    <Content Remove="package-lock.json" />
  </ItemGroup>

  <Target Name="BuildBenchmarkJs" BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsInputs;BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" Condition="Exists('$(ProjectDir)package.json')" />
  </Target>

</Project>
