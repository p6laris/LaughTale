#!/bin/sh
# LaughTale adoption ratchet — refuses commits that worsen a tracked metric.
#
# Installed via:  git config core.hooksPath .githooks
# Bypass (audit trail in reflog):  git commit --no-verify
#
# This exists because agent self-reporting is not evidence. The gate runs here
# so a regression cannot be committed even if the commit message claims success.

CLIENT_DIR="LaughTale.Client"
HARNESS="$CLIENT_DIR/scripts/audit-metrics.mjs"
BASELINE="$CLIENT_DIR/scripts/metrics-baseline.json"

# Only enforce when client source is part of this commit.
if ! git diff --cached --name-only | grep -q "^$CLIENT_DIR/src/"; then
    exit 0
fi

if [ ! -f "$HARNESS" ]; then
    echo "pre-commit: harness missing at $HARNESS — skipping ratchet." >&2
    exit 0
fi

if [ ! -f "$BASELINE" ]; then
    echo "pre-commit: no baseline yet. Run:  (cd $CLIENT_DIR && node scripts/audit-metrics.mjs --save)" >&2
    exit 0
fi

echo "pre-commit: checking adoption ratchet…"
cd "$CLIENT_DIR" || exit 0

if ! node scripts/audit-metrics.mjs --check; then
    cat >&2 <<'MSG'

  ────────────────────────────────────────────────────────────────
  COMMIT REJECTED — an adoption metric moved the wrong way.

  This is not a lint style complaint. One of the counters this
  roadmap exists to move has gone backwards.

  Do NOT:
    - edit scripts/audit-metrics.mjs
    - re-run --save to move the baseline
    - pass --no-verify

  Do:
    - read the REGRESSION line above; it names the metric
    - fix the code that caused it
    - if you believe the metric is wrong, STOP and write BLOCKED.md
  ────────────────────────────────────────────────────────────────

MSG
    exit 1
fi

exit 0
