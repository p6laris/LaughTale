<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoftMax.Islands</title>
    <!-- PrimeVue Aura-Inspired Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    
    <!-- Top Aura Navbar with Persistent Telemetry Island -->
    <header class="aura-navbar">
        <div class="aura-navbar-inner">
            <div style="display: flex; align-items: center; gap: 2rem;">
                <a href="/" class="brand-group">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" style="color: var(--p-primary-600); flex-shrink: 0;"><path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5"/><path fill="currentColor" d="M10.93 7.565a.75.75 0 1 0-.986-1.13l-3.437 3A.75.75 0 0 0 7 10.75h10a.75.75 0 0 0 0-1.5H9zM7 14.75h8l-1.93 1.685a.75.75 0 0 0 .986 1.13l3.437-3A.75.75 0 0 0 17 13.25H7a.75.75 0 0 0 0 1.5"/></svg>
                    <div>
                        <span class="brand-title">SoftMax.Islands</span>
                        <span class="aura-tag tag-slate" style="margin-left: 0.5rem; font-size: 0.6875rem;">v2.0</span>
                    </div>
                </a>

                <nav class="nav-menu">
                    <a href="/" class="nav-link">Showcase</a>
                    <a href="/About" class="nav-link">Architecture</a>
                </nav>
            </div>

            <!-- Persistent Island across View Transitions -->
            <div>
                <island name="persistent-telemetry" 
                        props="@(new SystemTelemetryProps("API Gateway", 3))" 
                        persist="telemetry-widget" 
                        hydrate="Load" />
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="app-container">
        @RenderBody()
    </main>

    <!-- Load Islands Bundle -->
    <script type="module" src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
