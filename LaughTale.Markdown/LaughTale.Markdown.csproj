<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>LaughTale.Markdown</PackageId>
    <AssemblyName>LaughTale.Markdown</AssemblyName>
    <RootNamespace>LaughTale.Markdown</RootNamespace>
    <Description>Markdig-powered Content Collections and Markdown processing with embedded Islands for LaughTale</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaughTale.Core\LaughTale.Core.csproj" />
  </ItemGroup>

</Project>
