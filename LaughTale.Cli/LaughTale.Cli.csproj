<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>laughtale</ToolCommandName>
    <PackageId>LaughTale.Cli</PackageId>
    <Version>1.0.0</Version>
    <Title>LaughTale CLI Tool</Title>
    <Authors>LaughTale Team</Authors>
    <Description>.NET Global Tool CLI for scaffolding, component ejecting, and Theme Studio token exports in LaughTale applications.</Description>
    <PackageTags>dotnet-tool;cli;islands;laughtale;eject</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
