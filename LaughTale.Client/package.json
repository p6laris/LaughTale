{
  "name": "laughtale",
  "version": "1.0.0",
  "description": "Ultra-lightweight multi-strategy client-side hydration engine for LaughTale Islands Architecture",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "laughtale": "./cli/laughtale.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "import": "./dist/runtime.mjs",
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.mjs"
    },
    "./islands": {
      "import": "./dist/runtime.mjs",
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.mjs"
    },
    "./iife": "./dist/index.js",
    "./iife/runtime": "./dist/runtime.js",
    "./adapters/react": "./dist/adapters/react.js",
    "./adapters/vue": "./dist/adapters/vue.js",
    "./adapters/svelte": "./dist/adapters/svelte.js",
    "./adapters/preact": "./dist/adapters/preact.js",
    "./adapters/vanilla": "./dist/adapters/vanilla.js",
    "./adapters/web-components": "./dist/adapters/web-components.js",
    "./adapters/solid": "./dist/adapters/solid.js",
    "./adapters/alpine": "./dist/adapters/alpine.js",
    "./tailwind": "./dist/styles/tailwind.preset.js",
    "./ssr": "./dist/ssr/index.js",
    "./ssr/react": "./dist/ssr/react.js",
    "./ssr/preact": "./dist/ssr/preact.js",
    "./ssr/vue": "./dist/ssr/vue.js",
    "./ssr/svelte": "./dist/ssr/svelte.js"
  },
  "scripts": {
    "gen:icons": "node ../scripts/gen-icons.mjs",
    "prebuild": "npm run gen:icons",
    "pretypecheck": "npm run gen:icons",
    "pretest": "npm run gen:icons",
    "build": "npm run typecheck && node esbuild.config.mjs --prod && npm run budget:chunks",
    "build:dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint:contracts": "node scripts/verify-contracts.mjs",
    "lint:metrics": "node scripts/audit-metrics.mjs --check",
    "budget:chunks": "node scripts/check-chunk-budgets.mjs",
    "verify": "npm run lint:contracts && npm run lint:metrics && npm test",
    "test": "node scripts/verify-contracts.mjs && node run-tests.mjs",
    "test:e2e": "npx playwright test"
  },
  "keywords": [
    "islands",
    "hydration",
    "ssr",
    "dotnet",
    "blazor"
  ],
  "author": "LaughTale",
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.17.4",
    "happy-dom": "^20.11.6",
    "lucide-static": "^1.33.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "vue": "^3.5.42"
  }
}
