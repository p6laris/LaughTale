                    <div>
                        <span class="brand-title">SoftMax.LaughTale</span>
                        <span class="aura-tag tag-slate" style="margin-left: 0.5rem; font-size: 0.6875rem;">Docs v3.0</span>
                    </div>
                </a>
            </div>

            <div style="display: flex; align-items: center; gap: 1rem;">
                <!-- Dark Mode Toggle Button -->
                <button type="button" 
                        onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')" 
                        class="p-button p-button-secondary" 
                        style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;"
                        title="Toggle Dark Mode">
                    🌓
                </button>

                <!-- Persistent Telemetry Island across View Transitions -->
                <island name="persistent-telemetry" 
                        props="@(new SystemTelemetryProps("Docs Gateway", 3))" 
                        persist="docs-telemetry" 
                        hydrate="Load" />
            </div>
        </div>
