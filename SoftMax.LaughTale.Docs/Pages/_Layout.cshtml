<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoftMax.LaughTale Docs</title>
    <link rel="stylesheet" href="~/css/docs.css" />
    <script>
        // Synchronous theme initialization (prevents dark mode flash)
        if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body>
    
    <!-- Top Docs Navbar -->
    <header class="docs-navbar">
        <div class="docs-navbar-inner">
            <div style="display: flex; align-items: center; gap: 2rem;">
                <a href="/" class="brand-group">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" style="color: var(--p-primary-600); flex-shrink: 0;">
                        <path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5"/>
                        <path fill="currentColor" d="M10.93 7.565a.75.75 0 1 0-.986-1.13l-3.437 3A.75.75 0 0 0 7 10.75h10a.75.75 0 0 0 0-1.5H9zM7 14.75h8l-1.93 1.685a.75.75 0 0 0 .986 1.13l3.437-3A.75.75 0 0 0 17 13.25H7a.75.75 0 0 0 0 1.5"/>
                    </svg>
                    <div>
                        <span class="brand-title">SoftMax.LaughTale</span>
                        <span class="aura-tag tag-slate" style="margin-left: 0.5rem; font-size: 0.6875rem;">Docs v3.0</span>
                    </div>
                </a>
            </div>

            <div style="display: flex; align-items: center; gap: 1rem;">
                <!-- Dark Mode Toggle Button -->
                <button type="button" 
                        onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')" 
                        class="p-button p-button-secondary" 
                        style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;"
                        title="Toggle Dark Mode">
                    🌓
                </button>

                <!-- Persistent Telemetry Island across View Transitions -->
                <island name="persistent-telemetry" 
                        props="@(new SystemTelemetryProps("Docs Gateway", 3))" 
                        persist="docs-telemetry" 
                        hydrate="Load" />
            </div>
        </div>
    </header>

    <!-- Main 3-Column Docs Layout -->
    <div class="docs-layout">
        
        <!-- Left Sidebar Navigation -->
        <aside class="docs-sidebar">
            <div class="nav-section-title">Getting Started</div>
            <a href="/doc/01-getting-started" class="sidebar-link">Quickstart &amp; Setup</a>
            <a href="/doc/02-hydration-strategies" class="sidebar-link">Hydration Strategies</a>

            <div class="nav-section-title">Zero-JS Architecture</div>
            <a href="/doc/06-declarative-directives" class="sidebar-link">Declarative Directives</a>

            <div class="nav-section-title">Form &amp; Input Controls</div>
            <a href="/doc/07-input-number" class="sidebar-link">Number &amp; Currency</a>
            <a href="/doc/08-input-otp" class="sidebar-link">OTP Verification</a>
            <a href="/doc/09-input-password" class="sidebar-link">Password &amp; Meter</a>
            <a href="/doc/10-toggle-switch" class="sidebar-link">Aura Spring Switch</a>
            <a href="/doc/11-slider" class="sidebar-link">Range Slider</a>
            <a href="/doc/12-rating" class="sidebar-link">Star Rating</a>
            <a href="/doc/13-select-button" class="sidebar-link">Segmented SelectButton</a>
            <a href="/doc/14-chips" class="sidebar-link">InputTags &amp; Chips</a>
            <a href="/doc/15-datepicker" class="sidebar-link">Calendar DatePicker</a>

            <div class="nav-section-title">Data &amp; Structure</div>
            <a href="/doc/16-stepper" class="sidebar-link">Multi-Step Stepper</a>
            <a href="/doc/17-timeline" class="sidebar-link">Audit Log Timeline</a>
            <a href="/doc/18-camera" class="sidebar-link">Live WebRTC Camera</a>
            <a href="/doc/19-datagrid" class="sidebar-link">Filterable DataGrid</a>
            <a href="/doc/20-dropzone" class="sidebar-link">Document Dropzone</a>
            <a href="/doc/21-tree-select" class="sidebar-link">Hierarchical TreeSelect</a>

            <div class="nav-section-title">Metrics &amp; Visual Media</div>
            <a href="/doc/22-meter-group" class="sidebar-link">MeterGroup Gauge</a>
            <a href="/doc/23-avatar-group" class="sidebar-link">Avatar &amp; AvatarGroup</a>
            <a href="/doc/24-image-compare" class="sidebar-link">Image Compare Slider</a>
            <a href="/doc/25-progress-skeleton" class="sidebar-link">Progress &amp; Skeleton</a>

            <div class="nav-section-title">Navigation &amp; Overlays</div>
            <a href="/doc/26-drawer" class="sidebar-link">Offcanvas Drawer</a>
            <a href="/doc/27-speed-dial" class="sidebar-link">SpeedDial FAB</a>
            <a href="/doc/28-confirm-popup" class="sidebar-link">ConfirmPopup</a>
            <a href="/doc/29-modal-toast" class="sidebar-link">Modal &amp; Toast</a>

            <div class="nav-section-title">Deep Architecture</div>
            <a href="/doc/03-view-transitions" class="sidebar-link">View Transitions</a>
            <a href="/doc/04-slots-and-projection" class="sidebar-link">Server Slot Projection</a>
            <a href="/doc/05-content-collections" class="sidebar-link">Content Collections</a>
        </aside>

        <!-- Center Markdown Content Body -->
        <main class="docs-main">
            @RenderBody()
        </main>

        <!-- Right Sticky Table of Contents (TOC) -->
        <aside class="docs-toc">
            @await RenderSectionAsync("Toc", required: false)
        </aside>

    </div>

    <!-- Client Islands Engine Bundle -->
    <script type="module" src="~/js/main.js"></script>

    <!-- Active Navigation & ScrollSpy Script -->
    <script>
        function updateActiveState() {
            // 1. Highlight Active Sidebar Link
            const currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll('.sidebar-link').forEach(link => {
                const href = link.getAttribute('href')?.toLowerCase();
                link.classList.toggle('active', href === currentPath || (currentPath === '/' && href?.includes('01-getting-started')));
            });

            // 2. TOC ScrollSpy Observer
            const headings = document.querySelectorAll('.laughtale-markdown-content h2, .laughtale-markdown-content h3');
            const tocLinks = document.querySelectorAll('.toc-link');
            
            if (headings.length > 0 && tocLinks.length > 0) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const id = entry.target.getAttribute('id');
                            tocLinks.forEach(l => {
                                l.classList.toggle('active', l.getAttribute('href') === `#${id}`);
                            });
                        }
                    });
                }, { rootMargin: '0px 0px -70% 0px' });

                headings.forEach(h => observer.observe(h));
            }
        }

        document.addEventListener('DOMContentLoaded', updateActiveState);
        window.addEventListener('island:page-loaded', updateActiveState);
    </script>
</body>
</html>
