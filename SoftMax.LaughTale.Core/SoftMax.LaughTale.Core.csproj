    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>SoftMax.LaughTale.Core</PackageId>
    <AssemblyName>SoftMax.LaughTale.Core</AssemblyName>
