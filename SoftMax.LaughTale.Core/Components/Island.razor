@namespace SoftMax.LaughTale.Core.Components
@using Microsoft.AspNetCore.Components
@using SoftMax.LaughTale.Core.Enums
@using SoftMax.LaughTale.Core.Serialization

<div class="@Class"
     style="@Style"
     data-island="@Name"
     data-props="@SerializedProps"
     data-hydrate="@Hydrate.ToString().ToLowerInvariant()"
     data-framework="@(Framework == IslandFramework.Vanilla ? null : Framework.ToString().ToLowerInvariant())"
     data-media="@Media"
     data-island-id="@ElementId"
     data-persist="@PersistId">
    @if (ChildContent != null)
    {
        <div data-slot="default" class="island-slot">
            @ChildContent
        </div>
        <!--island:end:@Name-->
    }
</div>

@code {
    /// <summary>
    /// The unique name of the island matching the TypeScript island definition.
    /// </summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>
    /// The strongly-typed props object passed from the server to the client-side island.
    /// </summary>
    [Parameter] public object? Props { get; set; }

    /// <summary>
    /// The client-side hydration strategy (Load, Idle, Visible, Media, Interaction, Never).
    /// </summary>
    [Parameter] public HydrateStrategy Hydrate { get; set; } = HydrateStrategy.Load;

    /// <summary>
    /// The target UI framework adapter (Vanilla, Preact, React, Vue, Alpine, Svelte).
    /// </summary>
    [Parameter] public IslandFramework Framework { get; set; } = IslandFramework.Vanilla;

    /// <summary>
    /// Optional CSS Media query when using HydrateStrategy.Media (e.g. "(max-width: 768px)").
    /// </summary>
    [Parameter] public string? Media { get; set; }

    /// <summary>
    /// Persistent island ID across SPA view transitions.
    /// If set, the island DOM node and active state will be preserved when navigating between pages.
    /// </summary>
    [Parameter] public string? Persist { get; set; }

    /// <summary>
    /// Optional CSS class for the island container.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Optional inline styles for the island container.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Optional DOM ID for the island container.
    /// </summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>
    /// Server-rendered fallback / slot content rendered inside the island.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ElementId => Id ?? $"island-{Guid.NewGuid():N}";
    private string? PersistId => string.IsNullOrWhiteSpace(Persist) ? null : Persist;
    private string SerializedProps => IslandJson.SerializeProps(Props);
}
