@page "/enterprise"
@model SoftMax.LaughTale.Showcase.Pages.EnterpriseModel
@{
    ViewData["Title"] = "Enterprise Component Explorer (64 Components)";
}

<!-- Floating Toast Notification Container -->
<island-toast />

<!-- Top Breadcrumb & Quick Actions Bar -->
<div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius-xl); padding: 0.75rem 1.25rem; box-shadow: var(--p-shadow-sm); flex-wrap: wrap;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <island-breadcrumb items="@Model.Breadcrumbs" hydrate="Load" />
    </div>
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="aura-tag tag-emerald">64 Active Components</span>
        <span class="aura-tag tag-slate">Tailwind CSS v4 Tokens</span>
    </div>
</div>

<!-- Main Component Section Container (Each Component Has Its Own Dedicated Tab View) -->
<div class="enterprise-sections" style="width: 100%;">

    <!-- Dynamic Form -->
    <section id="sec-dynamic-form" class="component-card active-card" style="display: block;">
        <div class="card-header">
            <div>
                <h2>Dynamic Form Generator</h2>
                <p>Generated automatically from C# <code>OperatorRegistrationDto</code> with DataAnnotations reflection.</p>
            </div>
            <span class="aura-tag tag-emerald">Reflect</span>
        </div>
        <div class="card-body" style="max-width: 640px;">
            <island-dynamic-form schema="@Model.RegistrationFormSchema" />
        </div>
    </section>

    <!-- InputText -->
    <section id="sec-input-text" class="component-card">
        <div class="card-header">
            <div>
                <h2>InputText</h2>
                <p>Aura enterprise text input extension with icon fields, zero-flicker clear actions, size scaling, filled variants, and seamless FloatLabel/IftaLabel integration.</p>
            </div>
            <span class="aura-tag tag-emerald">Form Control</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Demo 1: Basic & Clear Icon -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Basic &amp; Clear Icon</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Standard two-way value binding and zero-flicker clear icon button that resets input without losing focus.</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-text-color);">Basic Input</label>
                        <island-input-text placeholder="Enter text..." fluid="true" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-text-color);">Clearable Input (Type to see Clear Button)</label>
                        <island-input-text value="Clearable content" showClear="true" placeholder="Type something..." fluid="true" />
                    </div>
                </div>
            </div>

            <!-- Demo 2: Sizes & Filled Variant -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Sizes &amp; Filled Variant</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Small and large size alternatives alongside the high-emphasis filled background variant.</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; align-items: end;">
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-text-color);">Small Size</label>
                        <island-input-text size="@ComponentSize.Small" placeholder="Small input..." fluid="true" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-text-color);">Normal (Default)</label>
                        <island-input-text placeholder="Normal input..." fluid="true" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-text-color);">Large Size</label>
                        <island-input-text size="@ComponentSize.Large" placeholder="Large input..." fluid="true" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-text-color);">Filled Variant</label>
                        <island-input-text variant="@InputVariant.Filled" placeholder="Filled input..." fluid="true" />
                    </div>
                </div>
            </div>

            <!-- Demo 3: Icons & Help Text -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Leading / Trailing Icons &amp; Help Text</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Icons embedded cleanly within input padding and advisory help texts.</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-text-color);">Search Query</label>
                        <island-input-text iconLeft="search" placeholder="Search components or keywords..." fluid="true" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-text-color);">Username (With Advisory Help)</label>
                        <island-input-text id="username-demo" iconLeft="user" placeholder="Enter username..." helpText="Enter your corporate username to verify clearance." fluid="true" />
                    </div>
                </div>
            </div>

            <!-- Demo 4: Validation & Disabled -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Invalid &amp; Disabled States</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Form validation error ring and non-interactive states.</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-red-500);">Invalid (Outlined)</label>
                        <island-input-text value="invalid@@cluster" invalid="true" fluid="true" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-red-500);">Invalid (Filled)</label>
                        <island-input-text variant="@InputVariant.Filled" value="missing-token" invalid="true" fluid="true" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--p-text-color);">Disabled State</label>
                        <island-input-text value="system-generated-readonly" disabled="true" fluid="true" />
                    </div>
                </div>
            </div>

            <!-- Demo 5: FloatLabel & IftaLabel Integration -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">FloatLabel &amp; IftaLabel Integration</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Seamless integration with Over, On, and In (Ifta) floating labels.</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; align-items: end;">
                    <div>
                        <island-float-label label="Over Label" variant="@FloatLabelVariant.Over">
                            <island-input-text fluid="true" />
                        </island-float-label>
                    </div>
                    <div>
                        <island-float-label label="On Border Label" variant="@FloatLabelVariant.On">
                            <island-input-text fluid="true" />
                        </island-float-label>
                    </div>
                    <div>
                        <island-ifta-label label="Infield Top-Aligned">
                            <island-input-text fluid="true" />
                        </island-ifta-label>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FloatLabel & IftaLabel -->
    <section id="sec-floatlabel" class="component-card">
        <div class="card-header">
            <div>
                <h2>FloatLabel &amp; IftaLabel</h2>
                <p>Smooth floating labels with Over, On, and In (Ifta) positioning variants and automatic value/focus detection.</p>
            </div>
            <span class="aura-tag tag-emerald">Form Control</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Demo 1: Variants (Over, On, In) -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 1.25rem; color: var(--p-text-color);">Floating Position Variants</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
                    <div>
                        <island-float-label label="Username (Over)" variant="@FloatLabelVariant.Over">
                            <input type="text" class="p-input" style="width: 100%;" />
                        </island-float-label>
                    </div>
                    <div>
                        <island-float-label label="Email (On Border)" variant="@FloatLabelVariant.On">
                            <input type="text" class="p-input" style="width: 100%;" />
                        </island-float-label>
                    </div>
                    <div>
                        <island-ifta-label label="City (Infield / Ifta)">
                            <input type="text" class="p-input" style="width: 100%;" />
                        </island-ifta-label>
                    </div>
                </div>
            </div>

            <!-- Demo 2: Invalid State -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 1.25rem; color: var(--p-text-color);">Validation Error Highlight</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
                    <div>
                        <island-float-label label="Required Field (Over)" variant="@FloatLabelVariant.Over" invalid="true">
                            <input type="text" class="p-input invalid" style="width: 100%;" />
                        </island-float-label>
                    </div>
                    <div>
                        <island-float-label label="Required Field (On)" variant="@FloatLabelVariant.On" invalid="true">
                            <input type="text" class="p-input invalid" style="width: 100%;" />
                        </island-float-label>
                    </div>
                    <div>
                        <island-float-label label="Required Field (In)" variant="@FloatLabelVariant.In" invalid="true">
                            <input type="text" class="p-input invalid" style="width: 100%;" />
                        </island-float-label>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- IftaLabel -->
    <section id="sec-iftalabel" class="component-card">
        <div class="card-header">
            <div>
                <h2>IftaLabel (Infield Top-Aligned Label)</h2>
                <p>Enterprise infield top-aligned labels with focus transition, invalid highlighting, and automatic child integration.</p>
            </div>
            <span class="aura-tag tag-emerald">Form Control</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Demo 1: Basic Infield Top-Aligned Label -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Basic Infield Label</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Wrapping standard input and label with permanent top-aligned position.</p>
                <div style="max-width: 380px;">
                    <island-ifta-label label="Username">
                        <input type="text" class="p-input" style="width: 100%;" />
                    </island-ifta-label>
                </div>
            </div>

            <!-- Demo 2: Invalid State -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Invalid Infield Label</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Label automatically transitions to error theme when the wrapped input is invalid.</p>
                <div style="max-width: 380px;">
                    <island-ifta-label label="Username" invalid="true">
                        <input type="text" class="p-input invalid" style="width: 100%;" />
                    </island-ifta-label>
                </div>
            </div>
        </div>
    </section>

    <!-- Label -->
    <section id="sec-label" class="component-card">
        <div class="card-header">
            <div>
                <h2>Label</h2>
                <p>Accessible text labels for form controls with explicit id linking, required indicators, selection card wrappers, sizes, and disabled synchronization.</p>
            </div>
            <span class="aura-tag tag-emerald">Form Control</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Demo 1: Basic & Required -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Basic &amp; Required Form Labels</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Explicit association using the <code>for</code> attribute along with accessible required indicators.</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
                    <div>
                        <island-label for="lbl-basic-input" text="First Name" style="margin-bottom: 0.35rem;" />
                        <island-input-text input-id="lbl-basic-input" placeholder="Enter your first name..." fluid="true" />
                    </div>
                    <div>
                        <island-label for="lbl-req-input" text="Corporate Email Address" required="true" style="margin-bottom: 0.35rem;" />
                        <island-input-text input-id="lbl-req-input" placeholder="user@corporate.io" fluid="true" />
                    </div>
                </div>
            </div>

            <!-- Demo 2: Wrapper Mode (Implicit Association & Selection Cards) -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Wrapper Mode (Selection Cards)</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Labels wrapping form controls to associate them implicitly without explicit IDs. Ideal for card-style options.</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
                    <island-label wrapper="true" text="Mutual TLS 1.3" description="Continuous cryptographic re-authentication" badge="Recommended">
                        <island-checkbox binary="true" value="true" />
                    </island-label>
                    <island-label wrapper="true" text="Hardware Security Module (HSM)" description="FIPS 140-3 Level 4 Key Management" badge="Enterprise">
                        <island-checkbox binary="true" value="false" />
                    </island-label>
                </div>
            </div>

            <!-- Demo 3: Sizes & Disabled States -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Sizes &amp; Disabled State Reflection</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Small and large size metrics alongside automatic disabled state styling.</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; align-items: end;">
                    <div>
                        <island-label for="lbl-sm-input" text="Small Label" size="@ComponentSize.Small" style="margin-bottom: 0.35rem;" />
                        <island-input-text input-id="lbl-sm-input" size="@ComponentSize.Small" placeholder="Small input..." fluid="true" />
                    </div>
                    <div>
                        <island-label for="lbl-lg-input" text="Large Label" size="@ComponentSize.Large" style="margin-bottom: 0.35rem;" />
                        <island-input-text input-id="lbl-lg-input" size="@ComponentSize.Large" placeholder="Large input..." fluid="true" />
                    </div>
                    <div>
                        <island-label for="lbl-dis-input" text="Disabled Field Label" disabled="true" style="margin-bottom: 0.35rem;" />
                        <island-input-text input-id="lbl-dis-input" disabled="true" value="read-only-system-value" fluid="true" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- InputGroup -->
    <section id="sec-inputgroup" class="component-card">
        <div class="card-header">
            <div>
                <h2>InputGroup &amp; Addons</h2>
                <p>Enterprise layout container grouping text inputs, icons, buttons, dropdowns, checkboxes, FloatLabels, and IftaLabels with seamless corner rounding.</p>
            </div>
            <span class="aura-tag tag-emerald">Form Control</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Demo 1: Basic & Multiple Addons -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Basic &amp; Multiple Addons</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Combine text inputs with icons, prefixes, suffixes, and multi-addons.</p>
                <div style="display: flex; flex-direction: column; gap: 1rem; max-width: 460px;">
                    <!-- User Addon -->
                    <island-input-group>
                        <island-input-group-addon icon="user" />
                        <input type="text" class="p-input" placeholder="Username" style="flex: 1;" />
                    </island-input-group>

                    <!-- Website URL (Prefix + Suffix) -->
                    <island-input-group>
                        <island-input-group-addon text="https://" />
                        <input type="text" class="p-input" placeholder="website" style="flex: 1;" />
                        <island-input-group-addon text=".com" />
                    </island-input-group>

                    <!-- Multi-Addons: Clock + Star + Price + $ + .00 -->
                    <island-input-group>
                        <island-input-group-addon icon="clock" />
                        <island-input-group-addon icon="star" />
                        <input type="text" class="p-input" placeholder="Price" style="flex: 1;" />
                        <island-input-group-addon text="$" />
                        <island-input-group-addon text=".00" />
                    </island-input-group>
                </div>
            </div>

            <!-- Demo 2: Select & Dropdown inside InputGroup -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Select &amp; Dropdown Integration</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Group custom Select components alongside addons and inputs.</p>
                <div style="display: flex; flex-direction: column; gap: 1rem; max-width: 460px;">
                    <!-- Location Icon + Select -->
                    <island-input-group>
                        <island-input-group-addon icon="map-pin" />
                        <div style="flex: 1;">
                            <island-select placeholder="Select a City" options="@(new List<SelectButtonItem> { new("Rome", "rome"), new("Berlin", "berlin"), new("Paris", "paris") })" />
                        </div>
                    </island-input-group>

                    <!-- WWW + Website Input + Select -->
                    <island-input-group>
                        <island-input-group-addon text="www" />
                        <input type="text" class="p-input" placeholder="Website" style="flex: 1;" />
                        <div style="width: 150px;">
                            <island-select placeholder="Select a City" options="@(new List<SelectButtonItem> { new("Rome", "rome"), new("Berlin", "berlin"), new("Paris", "paris") })" />
                        </div>
                    </island-input-group>
                </div>
            </div>

            <!-- Demo 3: Buttons & Actions -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Buttons &amp; Interactive Actions</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Seamlessly integrated action buttons and telemetry badges.</p>
                <div style="display: flex; flex-direction: column; gap: 1rem; max-width: 460px;">
                    <!-- Search button + Input + Badge -->
                    <island-input-group>
                        <button type="button" class="p-button p-button-primary">Search</button>
                        <input type="text" class="p-input" placeholder="Keyword" style="flex: 1;" />
                        <island-input-group-addon text="8 results" />
                    </island-input-group>

                    <!-- Input + Search icon button -->
                    <island-input-group>
                        <input type="text" class="p-input" placeholder="Keyword" style="flex: 1;" />
                        <button type="button" class="p-button p-button-secondary">
                            <span style="display: flex; align-items: center;">@Html.Raw(SoftMax.LaughTale.Components.Icons.LucideIcons.Get("search", 16))</span>
                        </button>
                    </island-input-group>

                    <!-- Check addon + Vote input + Clear button -->
                    <island-input-group>
                        <island-input-group-addon icon="check" />
                        <input type="text" class="p-input" placeholder="Vote" style="flex: 1;" />
                        <button type="button" class="p-button p-button-secondary">
                            <span style="display: flex; align-items: center;">@Html.Raw(SoftMax.LaughTale.Components.Icons.LucideIcons.Get("x", 16))</span>
                        </button>
                    </island-input-group>
                </div>
            </div>

            <!-- Demo 4: Checkbox & Radio Addons -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Checkbox &amp; Radio Addons</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1.25rem;">Combine checkboxes or radio options directly within the input group frame.</p>
                <div style="display: flex; flex-direction: column; gap: 1rem; max-width: 460px;">
                    <island-input-group>
                        <island-input-group-addon>
