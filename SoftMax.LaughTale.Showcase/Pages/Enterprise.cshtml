@page "/enterprise"
@model SoftMax.LaughTale.Showcase.Pages.EnterpriseModel
@{
    ViewData["Title"] = "Enterprise Component Explorer (64 Components)";
}

<!-- Floating Toast Notification Container -->
<island-toast />

<!-- Top Breadcrumb & Quick Actions Bar -->
<div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius-xl); padding: 0.75rem 1.25rem; box-shadow: var(--p-shadow-sm); flex-wrap: wrap;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <island-breadcrumb items="@Model.Breadcrumbs" hydrate="Load" />
    </div>
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="aura-tag tag-emerald">64 Active Components</span>
        <span class="aura-tag tag-slate">Tailwind CSS v4 Tokens</span>
    </div>
</div>

<!-- Main Component Section Container (Each Component Has Its Own Dedicated Tab View) -->
<div class="enterprise-sections" style="width: 100%;">

    <!-- Dynamic Form -->
    <section id="sec-dynamic-form" class="component-card active-card" style="display: block;">
        <div class="card-header">
            <div>
                <h2>Dynamic Form Generator</h2>
                <p>Generated automatically from C# <code>OperatorRegistrationDto</code> with DataAnnotations reflection.</p>
            </div>
            <span class="aura-tag tag-emerald">Reflect</span>
        </div>
        <div class="card-body" style="max-width: 640px;">
            <island-dynamic-form schema="@Model.RegistrationFormSchema" />
        </div>
    </section>

    <!-- InputText -->
    <section id="sec-input-text" class="component-card">
        <div class="card-header">
            <div>
                <h2>InputText &amp; EnhancedInput</h2>
                <p>Standard and enhanced text inputs with leading icons, clear buttons, and fluid states.</p>
            </div>
            <span class="aura-tag tag-slate">Input</span>
        </div>
        <div class="card-body" style="max-width: 500px; display: flex; flex-direction: column; gap: 1rem;">
            <island-input-text placeholder="Standard text input..." />
            <island-enhanced-input placeholder="Enhanced input with leading icon..." icon="search" clearable="true" />
        </div>
    </section>

    <!-- Textarea -->
    <section id="sec-textarea" class="component-card">
        <div class="card-header">
            <div>
                <h2>Textarea</h2>
                <p>Multi-line textarea with auto-resize and character count telemetry.</p>
            </div>
            <span class="aura-tag tag-slate">Form</span>
        </div>
        <div class="card-body" style="max-width: 600px;">
            <island-textarea placeholder="Enter incident report logs or operational payload notes..." rows="5" />
        </div>
    </section>

    <!-- InputNumber -->
    <section id="sec-input-number" class="component-card">
        <div class="card-header">
            <div>
                <h2>InputNumber</h2>
                <p>Numeric stepper with currency formatting, min/max clamps, and increment triggers.</p>
            </div>
            <span class="aura-tag tag-slate">Numeric</span>
        </div>
        <div class="card-body" style="max-width: 400px;">
            <island-input-number value="1250" min="0" max="100000" step="50" prefix="$" />
        </div>
    </section>

    <!-- InputOtp -->
    <section id="sec-input-otp" class="component-card">
        <div class="card-header">
            <div>
                <h2>InputOtp (One-Time Password)</h2>
                <p>Secure multi-cell OTP PIN input with auto-advance and clipboard paste parsing.</p>
            </div>
            <span class="aura-tag tag-amber">Security</span>
        </div>
        <div class="card-body" style="max-width: 400px;">
            <island-input-otp length="6" integer-only="true" />
        </div>
    </section>

    <!-- InputPassword -->
    <section id="sec-input-password" class="component-card">
        <div class="card-header">
            <div>
                <h2>InputPassword</h2>
                <p>Password field with toggle visibility and interactive strength meter indicator.</p>
            </div>
            <span class="aura-tag tag-emerald">Auth</span>
        </div>
        <div class="card-body" style="max-width: 400px;">
            <island-input-password feedback="true" toggle-mask="true" placeholder="Enter secure key..." />
        </div>
    </section>

    <!-- InputMask -->
    <section id="sec-input-mask" class="component-card">
        <div class="card-header">
            <div>
                <h2>InputMask</h2>
                <p>Strict input formatting masks for phone numbers, SSNs, and license tokens.</p>
            </div>
            <span class="aura-tag tag-slate">Mask</span>
        </div>
        <div class="card-body" style="max-width: 400px;">
            <island-input-mask mask="+1 (999) 999-9999" placeholder="+1 (555) 019-2834" />
        </div>
    </section>

    <!-- AutoComplete -->
    <section id="sec-autocomplete" class="component-card">
        <div class="card-header">
            <div>
                <h2>AutoComplete & Combobox</h2>
                <p>Enterprise real-time typeahead suggestions with keyboard navigation, dropdown button, clear icon, multi-chip tokens, and custom templating.</p>
            </div>
            <span class="aura-tag tag-emerald">Form Control</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Demo 1: Basic & Command Shortcuts -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Command Palette with Shortcuts</h3>
                <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1rem;">Type a command or shortcut key to see instant suggestions.</p>
                <div style="max-width: 380px;">
                    <island-autocomplete placeholder="Type a command (e.g. Save)..." suggestions="@Model.CommandsList" show-clear="true" />
                </div>
            </div>

            <!-- Demo 2: Dropdown Trigger & Custom Options (Team Members) -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
                <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                    <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Dropdown Button Trigger</h3>
                    <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1rem;">Click the chevron button to open the full option list.</p>
                    <island-autocomplete placeholder="Search server regions..." suggestions="@Model.CityOptions" dropdown="true" show-clear="true" />
                </div>

                <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                    <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Custom Option Template (Team Members)</h3>
                    <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1rem;">Rich avatars, status indicators, and roles.</p>
                    <island-autocomplete placeholder="Search team members..." suggestions="@Model.TeamMembers" show-clear="true" />
                </div>
            </div>

            <!-- Demo 3: Grouped Technologies & Multi-Chip Mode -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
                <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                    <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Grouped Categories</h3>
                    <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1rem;">Grouped by Frontend, Backend, and Database tiers.</p>
                    <island-autocomplete placeholder="Search tech stack..." suggestions="@Model.GroupedTechnologies" dropdown="true" show-clear="true" />
                </div>

                <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                    <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Multiple Selection with Chips</h3>
                    <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1rem;">Select multiple items with removable inline tags.</p>
                    <island-autocomplete placeholder="Select technologies..." suggestions="@Model.GroupedTechnologies" multiple="true" show-clear="true" />
                </div>
            </div>

            <!-- Demo 4: Sizes & Variants -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 1rem; color: var(--p-text-color);">Sizes & Variants</h3>
                <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center;">
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: var(--p-text-muted); display: block; margin-bottom: 0.25rem;">Small</label>
                        <island-autocomplete placeholder="Small size..." suggestions="@Model.CityOptions" size="@ComponentSize.Small" />
                    </div>
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: var(--p-text-muted); display: block; margin-bottom: 0.25rem;">Filled Variant</label>
                        <island-autocomplete placeholder="Filled variant..." suggestions="@Model.CityOptions" variant="@InputVariant.Filled" />
                    </div>
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: var(--p-text-muted); display: block; margin-bottom: 0.25rem;">Invalid State</label>
                        <island-autocomplete placeholder="Invalid state..." suggestions="@Model.CityOptions" invalid="true" />
                    </div>
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: var(--p-text-muted); display: block; margin-bottom: 0.25rem;">Disabled</label>
                        <island-autocomplete placeholder="Disabled state..." suggestions="@Model.CityOptions" disabled="true" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Select -->
    <section id="sec-select" class="component-card">
        <div class="card-header">
            <div>
                <h2>Select (Single Select)</h2>
                <p>Custom dropdown selector with searchable filter and clear option.</p>
            </div>
            <span class="aura-tag tag-slate">Select</span>
        </div>
        <div class="card-body" style="max-width: 400px;">
            <island-select options="@Model.ListboxDatabases" placeholder="Select Database..." />
        </div>
    </section>

    <!-- MultiSelect -->
    <section id="sec-multiselect" class="component-card">
        <div class="card-header">
            <div>
                <h2>MultiSelect with Chips</h2>
                <p>Select multiple technologies with removable tag badges and search filter.</p>
            </div>
            <span class="aura-tag tag-emerald">Chips</span>
        </div>
        <div class="card-body" style="max-width: 500px;">
            <island-multiselect options="@Model.MultiSelectSkills" placeholder="Select technologies..." target-input-name="selected_tech" />
        </div>
    </section>

    <!-- CascadeSelect -->
    <section id="sec-cascadeselect" class="component-card">
        <div class="card-header">
            <div>
                <h2>CascadeSelect Multi-Level</h2>
                <p>Enterprise hierarchical cascading multi-tier flyout menu for deeply nested locations, categories, and datacenters.</p>
            </div>
            <span class="aura-tag tag-emerald">Form Control</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- Demo 1: Countries & Cities (3 Levels) -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
                <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                    <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Global City Selection (3-Tier)</h3>
                    <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1rem;">Browse Country -> State -> City with smooth flyout panels.</p>
                    <island-cascadeselect options="@Model.CascadeCountries" placeholder="Select a City" show-clear="true" target-input="selected_city" />
                </div>

                <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                    <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--p-text-color);">Datacenter Clusters with Icons</h3>
                    <p style="font-size: 0.8125rem; color: var(--p-text-muted); margin-bottom: 1rem;">Region -> Branch -> Edge Nodes with custom Lucide icons.</p>
                    <island-cascadeselect options="@Model.CascadeRegions" placeholder="Select Cluster Node..." show-clear="true" target-input="selected_region" />
                </div>
            </div>

            <!-- Demo 2: Sizes & Variants -->
            <div style="background: var(--p-surface-50); padding: 1.25rem; border-radius: var(--p-border-radius); border: 1px solid var(--p-border-color);">
                <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 1rem; color: var(--p-text-color);">Sizes & Variants</h3>
                <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center;">
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: var(--p-text-muted); display: block; margin-bottom: 0.25rem;">Small</label>
                        <island-cascadeselect options="@Model.CascadeCountries" placeholder="Small size..." size="@ComponentSize.Small" />
                    </div>
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: var(--p-text-muted); display: block; margin-bottom: 0.25rem;">Filled Variant</label>
                        <island-cascadeselect options="@Model.CascadeCountries" placeholder="Filled variant..." variant="@InputVariant.Filled" />
                    </div>
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: var(--p-text-muted); display: block; margin-bottom: 0.25rem;">Invalid State</label>
                        <island-cascadeselect options="@Model.CascadeCountries" placeholder="Invalid state..." invalid="true" />
                    </div>
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 0.75rem; font-weight: 600; color: var(--p-text-muted); display: block; margin-bottom: 0.25rem;">Disabled</label>
                        <island-cascadeselect options="@Model.CascadeCountries" placeholder="Disabled state..." disabled="true" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TreeSelect -->
    <section id="sec-treeselect" class="component-card">
        <div class="card-header">
            <div>
                <h2>TreeSelect</h2>
                <p>Dropdown with expandable tree hierarchy for department selection.</p>
            </div>
            <span class="aura-tag tag-slate">Tree</span>
        </div>
        <div class="card-body" style="max-width: 450px;">
            <island-tree-select placeholder="Select Department..." target-input-name="ts_dept" departments="@Model.DepartmentTree" />
        </div>
    </section>

    <!-- Checkbox -->
    <section id="sec-checkbox" class="component-card">
        <div class="card-header">
            <div>
                <h2>Checkbox</h2>
                <p>Animated Boolean and tristate checkboxes with accessible focus rings.</p>
            </div>
            <span class="aura-tag tag-slate">Toggle</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <island-checkbox label="Enable Zero-Trust Telemetry" checked="true" />
            <island-checkbox label="Enforce End-to-End Cryptographic Encryption" checked="true" />
            <island-checkbox label="Allow Anonymous Guest Tunneling" checked="false" />
        </div>
    </section>

    <!-- RadioButton -->
    <section id="sec-radio" class="component-card">
        <div class="card-header">
            <div>
                <h2>RadioButton</h2>
                <p>Mutual exclusion selection radio group with custom spring animations.</p>
            </div>
            <span class="aura-tag tag-slate">Form</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <island-radio-button name="env" value="prod" label="Production Multi-Region" checked="true" />
            <island-radio-button name="env" value="stage" label="Staging Isolated Sandbox" />
            <island-radio-button name="env" value="dev" label="Local Dev Docker Container" />
        </div>
    </section>

    <!-- ToggleSwitch -->
    <section id="sec-toggle-switch" class="component-card">
        <div class="card-header">
            <div>
                <h2>ToggleSwitch</h2>
                <p>Smooth iOS/macOS style switch for toggling features and services.</p>
            </div>
            <span class="aura-tag tag-emerald">Active</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; max-width: 400px;">
                <span style="font-weight: 600; color: var(--p-text-color);">High-Availability Clustering</span>
                <island-toggle-switch checked="true" />
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; max-width: 400px;">
                <span style="font-weight: 600; color: var(--p-text-color);">Automated SSL Rotation</span>
                <island-toggle-switch checked="true" />
            </div>
        </div>
    </section>

    <!-- Slider -->
    <section id="sec-slider" class="component-card">
        <div class="card-header">
            <div>
                <h2>Slider</h2>
                <p>Continuous and stepped range slider with live value readout.</p>
            </div>
            <span class="aura-tag tag-slate">Control</span>
        </div>
        <div class="card-body" style="max-width: 500px;">
            <island-slider value="65" min="0" max="100" />
        </div>
    </section>

    <!-- Rating -->
    <section id="sec-rating" class="component-card">
        <div class="card-header">
            <div>
                <h2>Rating</h2>
                <p>Interactive vector star rating with configurable count and reset button.</p>
            </div>
            <span class="aura-tag tag-amber">Feedback</span>
        </div>
        <div class="card-body" style="max-width: 300px;">
            <island-rating value="4" stars="5" />
        </div>
    </section>

    <!-- SelectButton -->
    <section id="sec-select-button" class="component-card">
        <div class="card-header">
            <div>
                <h2>SelectButton</h2>
                <p>Segmented button group for exclusive or multi-selection modes.</p>
            </div>
            <span class="aura-tag tag-slate">Segmented</span>
        </div>
        <div class="card-body" style="max-width: 450px;">
            <island-select-button options="@Model.Periods" value="Daily" />
        </div>
    </section>

    <!-- Chips -->
    <section id="sec-chips" class="component-card">
        <div class="card-header">
            <div>
                <h2>Chips Input</h2>
                <p>Enter-delimited chip tag creator with delete and duplicate prevention.</p>
            </div>
            <span class="aura-tag tag-emerald">Tags</span>
        </div>
        <div class="card-body" style="max-width: 500px;">
            <island-chips placeholder="Add IP or domain tag..." />
        </div>
    </section>

    <!-- ColorPicker -->
    <section id="sec-color-picker" class="component-card">
        <div class="card-header">
            <div>
                <h2>ColorPicker</h2>
                <p>Hex and RGB color selection with interactive palette canvas.</p>
            </div>
            <span class="aura-tag tag-amber">Design</span>
        </div>
        <div class="card-body" style="max-width: 300px;">
            <island-color-picker value="#10b981" />
        </div>
    </section>

    <!-- Knob -->
    <section id="sec-knob" class="component-card">
        <div class="card-header">
            <div>
                <h2>Knob (Rotary Gauge)</h2>
                <p>Circular rotary dial with SVG arc calculation and drag controls.</p>
            </div>
            <span class="aura-tag tag-emerald">Telemetry</span>
        </div>
        <div class="card-body" style="max-width: 300px; display: flex; justify-content: center;">
            <island-knob value="72" min="0" max="100" value-template="{value}%" size="140" />
        </div>
    </section>

    <!-- DatePicker -->
    <section id="sec-datepicker" class="component-card">
        <div class="card-header">
            <div>
                <h2>DatePicker Calendar</h2>
                <p>Interactive date selection popover with month navigation and time picker.</p>
            </div>
            <span class="aura-tag tag-slate">Date</span>
        </div>
        <div class="card-body" style="max-width: 400px;">
            <island-datepicker placeholder="Select deployment deadline..." show-icon="true" />
        </div>
    </section>

    <!-- FloatLabel -->
    <section id="sec-float-label" class="component-card">
        <div class="card-header">
            <div>
                <h2>FloatLabel Material Input</h2>
                <p>Floating animated label container that transitions smoothly on focus.</p>
            </div>
            <span class="aura-tag tag-slate">Material</span>
        </div>
        <div class="card-body" style="max-width: 400px;">
            <island-float-label label="Tenant Identifier">
                <island-input-text />
            </island-float-label>
        </div>
    </section>

    <!-- Security DataGrid -->
    <section id="sec-datagrid" class="component-card">
        <div class="card-header">
            <div>
                <h2>Security Clusters DataGrid</h2>
                <p>Enterprise table with real-time multi-column sorting, debounced search, and pagination.</p>
            </div>
            <span class="aura-tag tag-emerald">Live</span>
        </div>
        <div class="card-body">
            <island-datagrid items="@Model.GridRecords" columns="@Model.GridColumns" page-size="5" />
        </div>
    </section>

    <!-- DataView -->
    <section id="sec-dataview" class="component-card">
        <div class="card-header">
            <div>
                <h2>DataView (Grid &amp; List Layouts)</h2>
                <p>Switchable data presentation view with custom layout cards.</p>
            </div>
            <span class="aura-tag tag-slate">View</span>
        </div>
        <div class="card-body">
            <island-dataview items="@Model.GridRecords" layout="grid" />
        </div>
    </section>

    <!-- Paginator -->
    <section id="sec-paginator" class="component-card">
        <div class="card-header">
            <div>
                <h2>Paginator</h2>
                <p>Standalone pagination bar with page jumps and configurable page sizes.</p>
            </div>
            <span class="aura-tag tag-slate">Pagination</span>
        </div>
        <div class="card-body" style="max-width: 600px;">
            <island-paginator total-records="240" rows="10" />
        </div>
    </section>

    <!-- Splitter -->
    <section id="sec-splitter" class="component-card">
        <div class="card-header">
            <div>
                <h2>Splitter Panels</h2>
                <p>Draggable split divider gutter with smooth physics-assisted resizing.</p>
            </div>
            <span class="aura-tag tag-slate">Layout</span>
        </div>
        <div class="card-body">
            <island-splitter orientation="Horizontal" initial-ratio="40">
                <left-panel>
                    <div style="padding: 1.5rem;">
                        <h4 style="font-weight: 700; color: var(--p-text-color); margin-bottom: 0.5rem;">Left Explorer</h4>
                        <p style="font-size: 0.8125rem; color: var(--p-text-muted);">Directory tree and filter facets.</p>
                    </div>
                </left-panel>
                <right-panel>
                    <div style="padding: 1.5rem;">
                        <h4 style="font-weight: 700; color: var(--p-text-color); margin-bottom: 0.5rem;">Main Canvas</h4>
                        <p style="font-size: 0.8125rem; color: var(--p-text-muted);">Workspace viewport with live data stream.</p>
