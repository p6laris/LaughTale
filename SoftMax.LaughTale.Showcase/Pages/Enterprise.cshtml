@page "/enterprise"
@model SoftMax.LaughTale.Showcase.Pages.EnterpriseModel
@{
    ViewData["Title"] = "Aura Enterprise Components & Declarative Directives";
}

<!-- Breadcrumbs -->
<div style="margin-bottom: 1.5rem;">
    <island-breadcrumb items="@Model.Breadcrumbs" hydrate="Load" />
</div>

<!-- Hero Banner -->
<div class="hero-section" style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
        <span class="aura-tag tag-emerald">100% C# Strongly Typed</span>
        <span class="aura-tag tag-slate">Tailwind CSS v4 Tokens</span>
        <span class="aura-tag tag-emerald">Aura Theme</span>
        <span class="aura-tag tag-slate">Lucide Icons</span>
        <span class="aura-tag tag-amber">49 Active Components</span>
    </div>
    <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; color: var(--p-surface-950); margin-bottom: 0.75rem;">
        Enterprise UI Components &amp; Dynamic Form Generator
    </h1>
    <p style="font-size: 1.05rem; color: var(--p-surface-600); max-width: 800px; line-height: 1.6;">
        Production-grade enterprise components written in 100% C# Razor with Lucide vector icons, headless physics animations, and DataAnnotations-driven dynamic form generation.
    </p>
</div>

<!-- Floating Toast Container -->
<island-toast />

<!-- Scroll to Top Floating Button -->
<island-scroll-top />

<!-- ========================================== -->
<!-- 0. Dynamic Form Generator Showcase -->
<!-- ========================================== -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--p-surface-900);">Dynamic Form Generator (C# DataAnnotations Reflection)</h2>
            <p style="font-size: 0.875rem; color: var(--p-surface-500); margin-top: 0.25rem;">Generated automatically from <code>OperatorRegistrationDto</code> with <code>[Required]</code>, <code>[EmailAddress]</code>, <code>[DataType]</code>, and <code>[Range]</code> validation.</p>
        </div>
        <span class="aura-tag tag-emerald">Dynamic Forms</span>
    </div>

    <div style="max-width: 640px; background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius-xl); box-shadow: var(--p-shadow-sm); padding: 1.5rem;">
        <island-dynamic-form schema="@Model.RegistrationFormSchema" />
    </div>
</div>

<!-- ========================================== -->
<!-- 1. Interactive Splitter & Multi-Panel Workspace -->
<!-- ========================================== -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--p-surface-900);">Splitter (Resizable Multi-Panel Layouts)</h2>
            <p style="font-size: 0.875rem; color: var(--p-surface-500); margin-top: 0.25rem;">Drag the divider gutter with smooth physics-assisted split resizing.</p>
        </div>
        <span class="aura-tag tag-slate">Splitter</span>
    </div>

    <island-splitter orientation="Horizontal" initial-ratio="35" style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius-xl); box-shadow: var(--p-shadow-sm);">
        <left-panel>
            <div style="padding: 1.5rem;">
                <div style="font-weight: 700; font-size: 0.9375rem; color: var(--p-surface-900); margin-bottom: 0.5rem;">Left Sidebar Panel</div>
                <p style="font-size: 0.8125rem; color: var(--p-surface-600); line-height: 1.5;">Navigation tree, project directory structure, or telemetry filters.</p>
                <div style="margin-top: 1rem;">
                    <island-tree-select placeholder="Select Dept..." target-input-name="splitter_dept" departments="@Model.DepartmentTree" />
                </div>
            </div>
        </left-panel>
        <right-panel>
            <div style="padding: 1.5rem;">
                <div style="font-weight: 700; font-size: 0.9375rem; color: var(--p-surface-900); margin-bottom: 0.5rem;">Main Workspace Area</div>
                <p style="font-size: 0.8125rem; color: var(--p-surface-600); line-height: 1.5;">Primary workspace canvas with rich data viewports.</p>
                <div style="margin-top: 1rem; display: flex; gap: 0.75rem;">
                    <island-split-button label="Trigger Deploy" icon="⚡" menu="@Model.SplitButtonActions" />
                    <island-button variant="Outline">Refresh Node</island-button>
                </div>
            </div>
        </right-panel>
    </island-splitter>
</div>

<!-- ========================================== -->
<!-- 2. MultiSelect, CascadeSelect, & Listbox -->
<!-- ========================================== -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--p-surface-900);">Advanced Selectors: MultiSelect, CascadeSelect &amp; Listbox</h2>
            <p style="font-size: 0.875rem; color: var(--p-surface-500); margin-top: 0.25rem;">Chip tags, hierarchical multi-tier cascade popovers, and searchable listboxes.</p>
        </div>
        <span class="aura-tag tag-emerald">Selectors</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
        
        <!-- MultiSelect -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 0.5rem; color: var(--p-surface-900);">MultiSelect with Chips</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 1rem;">Select multiple technologies with removable tags.</p>
            <island-multiselect options="@Model.MultiSelectSkills" placeholder="Select technologies..." target-input-name="selected_tech" />
        </div>

        <!-- CascadeSelect -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 0.5rem; color: var(--p-surface-900);">CascadeSelect Multi-Level</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 1rem;">Cascading flyout menus for regional hierarchical datacenters.</p>
            <island-cascadeselect options="@Model.CascadeRegions" placeholder="Select Datacenter..." target-input-name="selected_region" />
        </div>

        <!-- Listbox -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 0.5rem; color: var(--p-surface-900);">Searchable Listbox</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 1rem;">Scrollable list with real-time debounced query filter.</p>
            <island-listbox options="@Model.ListboxDatabases" filter="true" target-input-name="selected_db" />
        </div>

    </div>
</div>

<!-- ========================================== -->
<!-- 3. PickList & OrderList (Dual-List Transfer & Reordering) -->
<!-- ========================================== -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--p-surface-900);">PickList &amp; OrderList (Dual-List Transfer &amp; Reordering)</h2>
            <p style="font-size: 0.875rem; color: var(--p-surface-500); margin-top: 0.25rem;">FLIP layout physics transfers and keyboard-accessible item reordering.</p>
        </div>
        <span class="aura-tag tag-slate">Transfer Lists</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 1.5rem;">
        
        <!-- PickList -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 1rem; color: var(--p-surface-900);">PickList Security Token Assigner</div>
            <island-picklist source="@Model.PickListSource" target="@Model.PickListTarget" source-header="Available Tokens" target-header="Assigned to Node" />
        </div>

        <!-- OrderList -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 1rem; color: var(--p-surface-900);">OrderList Pipeline Execution Sequence</div>
            <island-orderlist items="@Model.OrderListTasks" header="Pipeline Order" />
        </div>

    </div>
</div>

<!-- ========================================== -->
<!-- 4. OrgChart Hierarchy Visualization -->
<!-- ========================================== -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--p-surface-900);">Organizational Tree Chart (OrgChart)</h2>
            <p style="font-size: 0.875rem; color: var(--p-surface-500); margin-top: 0.25rem;">Collapsible node branches, role badges, and interactive drill-down cards.</p>
        </div>
        <span class="aura-tag tag-emerald">OrgChart</span>
    </div>

    <div style="background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius-xl); box-shadow: var(--p-shadow-sm); padding: 1.5rem; overflow-x: auto;">
        <island-orgchart root="@Model.OrgChartRoot" />
    </div>
</div>

<!-- ========================================== -->
<!-- 5. Terminal CLI & Galleria Media Stage -->
<!-- ========================================== -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--p-surface-900);">Interactive CLI Terminal &amp; Responsive Galleria</h2>
            <p style="font-size: 0.875rem; color: var(--p-surface-500); margin-top: 0.25rem;">Type commands (e.g. <code>help</code>, <code>status</code>, <code>version</code>) or inspect server media.</p>
        </div>
        <span class="aura-tag tag-slate">Interactive</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 1.5rem;">
        
        <!-- Terminal -->
        <div>
            <island-terminal prompt="operator@zero-trust:~$" />
        </div>

        <!-- Galleria -->
        <div>
            <island-galleria images="@Model.GalleriaImages" />
        </div>

    </div>
</div>

<!-- ========================================== -->
<!-- 6. Compound Components & Atomic Blocks Showcase -->
<!-- ========================================== -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--p-surface-900);">Compound Components &amp; Atomic UI Blocks</h2>
            <p style="font-size: 0.875rem; color: var(--p-surface-500); margin-top: 0.25rem;">Radix / shadcn-style atomic composition: cards, fields, input groups, dialogs, and accordions built with clean customizable CSS tokens.</p>
        </div>
        <span class="aura-tag tag-emerald">Compound Blocks</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem;">
        
        <!-- Block 1: Compound Card with Fields -->
        <island-card>
            <island-card-header>
                <island-card-title>Telemetry Ingress Gateway</island-card-title>
                <island-card-description>Configure zero-trust ingress credentials.</island-card-description>
            </island-card-header>

            <island-card-content class="space-y-4">
                <island-field>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <island-label for="secKey" required="true">Security Key</island-label>
                        <span class="aura-tag tag-emerald" style="font-size: 0.6875rem;">HSM Active</span>
                    </div>
                    <island-input-group>
                        <island-input-icon icon="🔒" />
                        <island-input-text id="secKey" name="secKey" placeholder="HSM-KEY-9948-X" />
                        <island-input-icon icon="⚡" position="Right" />
                    </island-input-group>
                    <island-helper-text>Keys are ephemeral and rotate every 3600 seconds.</island-helper-text>
                </island-field>

                <island-field>
                    <island-label for="opEmail">Operator Email</island-label>
                    <island-input-text id="opEmail" name="opEmail" value="alice@zero-trust.io" />
                </island-field>
            </island-card-content>

            <island-card-footer style="display: flex; justify-content: flex-end; gap: 0.75rem;">
                <island-button variant="Outline" size="Small">Revoke</island-button>
                <island-button variant="Solid" size="Small">Deploy Ingress</island-button>
            </island-card-footer>
        </island-card>

        <!-- Block 2: Compound Dialog Modal -->
        <island-card>
            <island-card-header>
                <island-card-title>Compound Dialog System</island-card-title>
                <island-card-description>Accessible, spring-animated focus-trapped modal.</island-card-description>
            </island-card-header>

            <island-card-content style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem 1rem;">
                <div style="font-size: 2.5rem; margin-bottom: 1rem;">🛡️</div>
                <island-dialog id="auditModal">
                    <island-dialog-trigger>
                        <island-button variant="Solid" size="Medium">Launch Audit Review Dialog</island-button>
                    </island-dialog-trigger>
                    <island-dialog-content title="Cluster Security Audit" description="Review automated cryptographic sign-off parameters.">
                        <p style="font-size: 0.875rem; color: var(--p-surface-600); line-height: 1.6; margin-bottom: 1rem;">
                            All nodes are currently verified against the FIPS 140-3 HSM Root Key ledger. Zero anomalous egress detected in the last 24 hours.
                        </p>
                        <island-dialog-footer>
                            <island-dialog-close>
                                <island-button variant="Outline" size="Small">Dismiss</island-button>
                            </island-dialog-close>
                            <island-button variant="Solid" size="Small">Approve Ledger</island-button>
                        </island-dialog-footer>
                    </island-dialog-content>
                </island-dialog>
            </island-card-content>
        </island-card>

    </div>
</div>

<!-- ========================================== -->
<!-- 7. Aura Form Controls Suite -->
<!-- ========================================== -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--p-surface-900);">Aura Form &amp; Input Controls</h2>
            <p style="font-size: 0.875rem; color: var(--p-surface-500); margin-top: 0.25rem;">InputNumber, OTP, Password strength metering, ToggleSwitch, and Sliders.</p>
        </div>
        <span class="aura-tag tag-emerald">Form Controls</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        
        <!-- InputNumber -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 0.5rem; color: var(--p-surface-900);">InputNumber (Currency &amp; Steppers)</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 1rem;">Formatted currency mode with bounds check.</p>
            <island-input-number mode="Currency" currency="USD" value="2499.50" min="0" max="100000" step="50" target-input-name="cluster_budget" />
        </div>

        <!-- InputOtp -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 0.5rem; color: var(--p-surface-900);">InputOtp (6-Digit Security Code)</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 1rem;">Auto-focus jump, backspace handling &amp; clipboard paste.</p>
            <island-input-otp length="6" target-input-name="mfa_otp" />
        </div>

        <!-- InputPassword -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 0.5rem; color: var(--p-surface-900);">InputPassword (Real-Time Strength Meter)</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 1rem;">Eye toggle, entropy score &amp; color-coded meter.</p>
            <island-input-password feedback="true" toggle-mask="true" target-input-name="operator_pwd" />
        </div>

        <!-- ToggleSwitch & Slider -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 0.5rem; color: var(--p-surface-900);">ToggleSwitch &amp; Physics Slider</div>
                <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 1rem;">Custom spring thumb transitions and range slider.</p>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                    <span style="font-size: 0.8125rem; font-weight: 600; color: var(--p-surface-700);">Enforce Zero-Trust</span>
                    <island-toggle-switch checked="true" target-input-name="zero_trust_active" />
                </div>
            </div>
            <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.5rem;">
                    <span>Replication Factor</span>
                    <span style="font-weight: 700; color: var(--p-primary-600);">3 Nodes</span>
                </div>
                <island-slider value="3" min="1" max="10" step="1" target-input-name="replica_count" />
            </div>
        </div>

    </div>
</div>

<!-- ========================================== -->
<!-- 8. Interactive Accordion, Tabs, & DataGrid -->
<!-- ========================================== -->
<div style="margin-bottom: 2.5rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <div>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--p-surface-900);">Enterprise Data &amp; Navigation Panels</h2>
            <p style="font-size: 0.875rem; color: var(--p-surface-500); margin-top: 0.25rem;">Accordion tabs, sliding indicator tabs, and virtualized DataGrid.</p>
        </div>
        <span class="aura-tag tag-emerald">Data &amp; Layout</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem;">
        
        <!-- Accordion -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 1rem; color: var(--p-surface-900);">Security Architecture Accordion</div>
            <island-accordion tabs="@Model.AccordionTabs" />
        </div>

        <!-- Sliding Tabs -->
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 1rem; color: var(--p-surface-900);">Sliding Tab Indicator</div>
            <island-tabs tabs="@Model.TabSections" />
        </div>

    </div>

    <!-- DataGrid -->
    <div style="margin-top: 1.5rem;">
        <div class="p-card" style="padding: 1.5rem; border-radius: var(--p-border-radius-xl);">
            <div style="font-weight: 700; font-size: 0.875rem; margin-bottom: 1rem; color: var(--p-surface-900);">Enterprise Operator Security Grid</div>
            <island-datagrid columns="@Model.GridColumns" data="@Model.GridRecords" paginate="true" page-size="4" search="true" />
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 9. Dock Navigation Bar (macOS Style) -->
<!-- ========================================== -->
<div style="margin-bottom: 3rem; display: flex; justify-content: center;">
    <island-dock items="@Model.DockItems" position="Bottom" />
</div>

<!-- SpeedDial Floating Action Trigger -->
<island-speed-dial actions="@Model.QuickActions" direction="Up" />
