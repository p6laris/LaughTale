@page "/enterprise"
@model SoftMax.LaughTale.Showcase.Pages.EnterpriseModel
@{
    ViewData["Title"] = "Aura Enterprise Components & Declarative Directives";
}

<!-- Breadcrumbs -->
<div style="margin-bottom: 1.5rem;">
    <island-breadcrumb items="@Model.Breadcrumbs" hydrate="Load" />
</div>

<!-- Hero Banner -->
<div class="hero-section" style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
        <span class="aura-tag tag-emerald">100% C# Razor</span>
        <span class="aura-tag tag-slate">Zero TypeScript / Zero JS</span>
        <span class="aura-tag tag-emerald">Aura Theme</span>
        <span class="aura-tag tag-slate">Lucide Icons</span>
    </div>
    <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; color: var(--p-surface-950); margin-bottom: 0.75rem;">
        Enterprise UI Components &amp; Declarative Directives
    </h1>
    <p style="font-size: 1.05rem; color: var(--p-surface-600); max-width: 800px; line-height: 1.6;">
        Production-grade enterprise components written in 100% C# Razor with Lucide vector icons. Zero npm build steps, zero client JavaScript maintenance.
    </p>
</div>

<!-- Floating Toast Container -->
<island-toast />

<!-- Scroll to Top Floating Button -->
<island-scroll-top />

<!-- ========================================== -->
<!-- 1. Form & Input Controls Suite -->
<!-- ========================================== -->
<div class="p-card" style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--p-surface-900);">1. Form &amp; Input Controls (Aura Suite)</h2>
            <p style="font-size: 0.8125rem; color: var(--p-surface-500); margin-top: 0.25rem;">Formatted numeric &amp; currency inputs, OTP boxes, password strength meters, segmented buttons, sliders, color pickers, and auto-complete comboboxes.</p>
        </div>
        <span class="aura-tag tag-slate">Inputs &amp; Controls</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
        
        <!-- Currency & Money Input -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Currency &amp; Money Input</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Formatted currency with thousands separator &amp; step buttons:</p>
            <island-currency value="2450.50" currency="USD" target-input="InvoiceAmount" hydrate="Load" />
        </div>

        <!-- 6-Digit OTP Verification Input -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">6-Digit OTP Verification</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Auto-advancing verification boxes with backspace &amp; paste support:</p>
            <island-otp length="6" target-input="AuthCode" hydrate="Load" />
        </div>

        <!-- AutoComplete / Combobox -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">AutoComplete / Search Dropdown</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Filterable dropdown with live item search:</p>
            <island-autocomplete items="@Model.CityOptions" placeholder="Search city..." target-input="SelectedCity" hydrate="Load" />
        </div>

        <!-- Password with Strength Meter -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Password &amp; Live Strength Meter</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Eye visibility toggle with 3-stage color strength bar:</p>
            <island-password placeholder="Create secure password..." target-input="MasterPassword" hydrate="Load" />
        </div>

        <!-- ColorPicker -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Interactive Color Picker</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Palette swatches with native color input:</p>
            <island-color-picker value="#10b981" target-input="BrandColor" hydrate="Load" />
        </div>

        <!-- Inplace Click-to-Edit -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Inplace Click-to-Edit</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Inline text editor with save and cancel:</p>
            <island-inplace value="Cluster-US-East-Primary" target-input="ClusterName" hydrate="Load" />
        </div>

        <!-- Segmented SelectButton -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Segmented Button Select</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Aura pill toggle selector:</p>
            <island-select-button items="@Model.Periods" value="monthly" target-input="SelectedPeriod" hydrate="Load" />
        </div>

        <!-- Range Slider -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Volume / Range Slider</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Step-based slider with numeric indicators:</p>
            <island-slider min="0" max="100" value="65" step="5" target-input="ClusterCapacity" hydrate="Load" />
        </div>

        <!-- Star Rating -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Interactive Star Rating</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Hover preview &amp; cancellation:</p>
            <island-rating stars="5" value="4" allow-cancel="true" target-input="UserRating" hydrate="Load" />
        </div>

        <!-- Toggle Switch -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Toggle Switch</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Smooth animated boolean toggle:</p>
            <island-switch checked="true" label="Auto-Sync Enabled" target-input="AutoSync" hydrate="Load" />
        </div>

        <!-- Tag / Chip Input -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Tag / Chip Input</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Add/remove tags on enter or comma:</p>
            <island-chips values='@new[] { "Zero-Trust", "mTLS", "Production" }' target-input="ClusterTags" hydrate="Load" />
        </div>

        <!-- DatePicker Calendar -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Calendar DatePicker</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Full interactive month/year popup calendar:</p>
            <island-datepicker placeholder="Choose expiration date..." target-input="CertExpiration" hydrate="Load" />
        </div>

    </div>
</div>

<!-- ========================================== -->
<!-- 2. Accordions & Tab Navigation Panels -->
<!-- ========================================== -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
    
    <!-- Accordion Section -->
    <div class="p-card">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
            <h2 style="font-size: 1.125rem; font-weight: 700; color: var(--p-surface-900);">2. Collapsible Accordion</h2>
            <span class="aura-tag tag-slate">&lt;island-accordion /&gt;</span>
        </div>
        <island-accordion tabs="@Model.AccordionTabs" active-index="0" hydrate="Load" />
    </div>

    <!-- Tabs Section -->
    <div class="p-card">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
            <h2 style="font-size: 1.125rem; font-weight: 700; color: var(--p-surface-900);">3. Underlined Tabs</h2>
            <span class="aura-tag tag-slate">&lt;island-tabs /&gt;</span>
        </div>
        <island-tabs tabs="@Model.TabSections" active-index="0" hydrate="Load" />
    </div>

</div>

<!-- ========================================== -->
<!-- 3. Metrics, Gauges & Radial Knob -->
<!-- ========================================== -->
<div class="p-card" style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--p-surface-900);">4. Gauges, Metrics &amp; Radial Knob</h2>
            <p style="font-size: 0.8125rem; color: var(--p-surface-500); margin-top: 0.25rem;">Meter bars, circular dial knobs, avatar stacks, and progress indicators.</p>
        </div>
        <span class="aura-tag tag-slate">Visual Metrics</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; align-items: center;">
        
        <!-- Radial Knob -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem; text-align: center;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Radial Dial Knob</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 1rem;">Click &amp; drag circular dial:</p>
            <div style="display: flex; justify-content: center;">
                <island-knob value="85" size="110" color="var(--p-primary-600)" target-input="ClusterLoad" hydrate="Load" />
            </div>
        </div>

        <!-- MeterGroup -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Storage Breakdown Meter</div>
            <island-meter-group values="@Model.StorageMetrics" max="100" hydrate="Load" />
        </div>

        <!-- Avatar Group -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Operator Avatar Stack</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 1rem;">Overlapping avatar pills with count overflow:</p>
            <island-avatar-group avatars="@Model.TeamAvatars" max="4" hydrate="Load" />
        </div>

    </div>
</div>

<!-- ========================================== -->
<!-- 4. Real-Time Audit Log & DataGrid -->
<!-- ========================================== -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
    
    <!-- Audit Log Timeline -->
    <div class="p-card">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
            <h2 style="font-size: 1.125rem; font-weight: 700; color: var(--p-surface-900);">5. Real-Time Audit Log Timeline</h2>
            <span class="aura-tag tag-slate">&lt;island-timeline /&gt;</span>
        </div>
        <island-timeline events="@Model.AuditEvents" hydrate="Visible" />
    </div>

    <!-- Enterprise DataGrid -->
    <div class="p-card">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
            <h2 style="font-size: 1.125rem; font-weight: 700; color: var(--p-surface-900);">6. Filterable &amp; Sortable DataGrid</h2>
            <span class="aura-tag tag-slate">&lt;island-datagrid /&gt;</span>
        </div>
        <island-datagrid columns="@Model.GridColumns" data="@Model.GridRecords" page-size="4" title="Cluster Operators" hydrate="Visible" />
    </div>

</div>

<!-- ========================================== -->
<!-- 5. Declarative Directives (Zero-JS) -->
<!-- ========================================== -->
<div class="p-card">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
            <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--p-surface-900);">7. Declarative Razor Directives (Zero Scripts)</h2>
            <p style="font-size: 0.8125rem; color: var(--p-surface-500); margin-top: 0.25rem;">Live state, tooltips, hotkeys, input formatting, clipboard copying, and event dispatching written directly in HTML attributes.</p>
        </div>
        <span class="aura-tag tag-emerald">l-hotkey &bull; l-tooltip &bull; l-persist</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        
        <!-- Live Pricing Calculator with LocalStorage Persistence -->
        <div l-state='{ "licenses": 5, "pricePerSeat": 120 }' l-persist="enterprise_calc" style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Reactive Calc &amp; Storage Persistence</div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                <label style="font-size: 0.8125rem; color: var(--p-surface-600);">Seats:</label>
                <input type="number" l-model="licenses" min="1" max="100" style="padding: 0.35rem 0.5rem; border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); width: 80px;" />
            </div>
            <div style="font-size: 1.125rem; font-weight: 800; color: var(--p-primary-600);">
                Total: $<span l-bind="(licenses * pricePerSeat).toLocaleString()">600</span> /mo
            </div>
        </div>

        <!-- Aura Tooltips & Badges -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Tooltips &amp; Notification Badges</div>
            <p style="font-size: 0.75rem; color: var(--p-surface-500); margin-bottom: 0.75rem;">Hover buttons to view animated Aura tooltips:</p>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <button type="button" l-tooltip="Export Audit Log as PDF" l-badge="PDF" l-badge.info class="p-button p-button-secondary" style="font-size: 0.8125rem;">
                    Export 📄
                </button>
                <button type="button" l-tooltip.bottom="Clearance Level 4 Active" l-badge.dot l-badge.success class="p-button p-button-primary" style="font-size: 0.8125rem;">
                    Secure Token 🔒
                </button>
            </div>
        </div>

        <!-- Clipboard Copy & Toast Dispatch (l-copy, l-on:click) -->
        <div style="background: var(--p-surface-50); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius); padding: 1.25rem;">
            <div style="font-size: 0.875rem; font-weight: 700; color: var(--p-surface-900); margin-bottom: 0.5rem;">Clipboard &amp; Toast Dispatch</div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
                <code id="vault-key" style="background: white; padding: 0.35rem 0.5rem; border-radius: 4px; border: 1px solid var(--p-border-color); font-size: 0.75rem;">sec_live_994827104</code>
                <button type="button" l-copy="#vault-key" l-feedback="✓ Copied!" class="p-button p-button-secondary" style="padding: 0.35rem 0.6rem; font-size: 0.75rem;">Copy</button>
            </div>
            <button type="button" l-on:click="$emit('toast', { title: 'Security Clearance Verified', description: 'Zero-Trust session renewed for 8 hours.', severity: 'success' })" class="p-button p-button-primary" style="width: 100%; font-size: 0.8125rem;">
                Trigger Toast Notification 🔔
            </button>
        </div>

    </div>
</div>
