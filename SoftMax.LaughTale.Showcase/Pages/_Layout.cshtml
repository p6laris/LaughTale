<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoftMax.LaughTale</title>
    <!-- Aura-Inspired Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        // Synchronous theme initialization (prevents flash)
        if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body>
    
    <!-- Top Aura Navbar with Persistent Telemetry Island -->
    <header class="aura-navbar">
        <div class="aura-navbar-inner">
            <div style="display: flex; align-items: center; gap: 1.5rem;">
                <a href="/" class="brand-group">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="28" viewBox="0 0 25 24" style="color: var(--p-primary-600); flex-shrink: 0;"><path fill="currentColor" d="M8.967 4.43a4.3 4.3 0 0 0-.286-.679c-.367-.697-.942-1.33-1.667-1.683a.75.75 0 1 0-.657 1.349c.382.185.746.557.997 1.033q.1.194.17.39a4.3 4.3 0 0 0-1.748-.093a4.31 4.31 0 0 0-3.008 1.97a.75.75 0 0 0 1.269.8A2.81 2.81 0 0 1 6.001 6.23a2.8 2.8 0 0 1 1.723.286a5.55 5.55 0 0 0-2.446 2.516a.75.75 0 1 0 1.35.654A4.04 4.04 0 0 1 8.642 7.74c.39.957.71 1.885.913 2.951c.258 1.355.331 2.964.068 5.15a11.3 11.3 0 0 0-6.166 3.667a.75.75 0 0 0 .568 1.24h16a.75.75 0 0 0 .568-1.24a11.3 11.3 0 0 0-9.435-3.89c.223-2.114.145-3.765-.13-5.208c-.21-1.108-.535-2.076-.907-3.012a4.04 4.04 0 0 1 2.435.7a.75.75 0 1 0 .843-1.242a5.55 5.55 0 0 0-3.687-.932c.29-.49.732-.895 1.293-1.14a2.81 2.81 0 0 1 2.347.04a.75.75 0 0 0 .648-1.35a4.31 4.31 0 0 0-3.596-.063a4.3 4.3 0 0 0-1.437 1.02m9.207 14.82H5.877a9.77 9.77 0 0 1 6.148-2.164a9.78 9.78 0 0 1 6.149 2.163"/><path fill="currentColor" d="M18.025 7.5a2.75 2.75 0 1 0 0 5.5a2.75 2.75 0 0 0 0-5.5m-1.25 2.75a1.25 1.25 0 1 1 2.5 0a1.25 1.25 0 0 1-2.5 0"/></svg>
                    <div>
                        <span class="brand-title">SoftMax.LaughTale</span>
                        <span class="aura-tag tag-slate" style="margin-left: 0.5rem; font-size: 0.6875rem;">v3.0</span>
                    </div>
                </a>
            </div>

            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <!-- Global Theme Studio Trigger Button -->
                <button type="button" 
                        onclick="document.dispatchEvent(new CustomEvent('studio:open'))" 
                        class="p-button p-button-primary" 
                        style="padding: 0.35rem 0.75rem; font-size: 0.8125rem;">
                    🎨 Studio
                </button>

                <!-- Dark Mode Toggle Button -->
                <button type="button" 
                        onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')" 
                        class="p-button p-button-secondary" 
                        style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;"
                        title="Toggle Dark Mode">
                    🌓
                </button>

                <!-- Persistent Island across View Transitions -->
                <div>
                    <island name="persistent-telemetry" 
                            props="@(new SystemTelemetryProps("API Gateway", 3))" 
                            persist="telemetry-widget" 
                            hydrate="Load" />
                </div>
            </div>
        </div>
    </header>

    <!-- Global Theme Studio Island Drawer -->
    <island-theme-studio />

    <!-- Global App Layout with Sticky Sidebar -->
    <div style="max-width: 1400px; margin: 0 auto; display: flex; gap: 1.5rem; padding: 1.5rem 1rem 4rem; align-items: flex-start;">
        <!-- Global Main Sidebar -->
        <aside class="global-sidebar" style="position: sticky; top: 5.5rem; width: 240px; flex-shrink: 0; background: var(--p-surface-0); border: 1px solid var(--p-border-color); border-radius: var(--p-border-radius-xl); box-shadow: var(--p-shadow-sm); padding: 0.75rem; z-index: 20;">
            <div style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--p-text-muted); padding: 0.5rem 0.75rem 0.25rem;">Navigation</div>
            <nav style="display: flex; flex-direction: column; gap: 0.25rem;">
                <a href="/" class="nav-link @(Context.Request.Path == "/" ? "active" : "")" style="display: flex; align-items: center; gap: 0.625rem; padding: 0.625rem 0.75rem; border-radius: var(--p-border-radius); text-decoration: none; color: var(--p-text-color); font-weight: 600; font-size: 0.875rem; transition: background 0.15s ease;">
                    <span style="display: flex; width: 18px; height: 18px; color: var(--p-primary-600);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    </span>
                    <span>Showcase Home</span>
                </a>
                <a href="/enterprise" class="nav-link @(Context.Request.Path.StartsWithSegments("/enterprise") ? "active" : "")" style="display: flex; align-items: center; gap: 0.625rem; padding: 0.625rem 0.75rem; border-radius: var(--p-border-radius); text-decoration: none; color: var(--p-text-color); font-weight: 600; font-size: 0.875rem; transition: background 0.15s ease;">
                    <span style="display: flex; width: 18px; height: 18px; color: var(--p-primary-600);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
                    </span>
                    <span>Enterprise UI (64)</span>
                </a>
                <a href="/dashboard" class="nav-link @(Context.Request.Path.StartsWithSegments("/dashboard") ? "active" : "")" style="display: flex; align-items: center; gap: 0.625rem; padding: 0.625rem 0.75rem; border-radius: var(--p-border-radius); text-decoration: none; color: var(--p-text-color); font-weight: 600; font-size: 0.875rem; transition: background 0.15s ease;">
                    <span style="display: flex; width: 18px; height: 18px; color: var(--p-primary-600);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                    </span>
                    <span>Dashboard</span>
                </a>
                <a href="/About" class="nav-link @(Context.Request.Path.StartsWithSegments("/About") ? "active" : "")" style="display: flex; align-items: center; gap: 0.625rem; padding: 0.625rem 0.75rem; border-radius: var(--p-border-radius); text-decoration: none; color: var(--p-text-color); font-weight: 600; font-size: 0.875rem; transition: background 0.15s ease;">
                    <span style="display: flex; width: 18px; height: 18px; color: var(--p-primary-600);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    </span>
                    <span>Architecture</span>
                </a>
            </nav>

            <div style="border-top: 1px solid var(--p-border-color); margin: 0.75rem 0;"></div>

            <div style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--p-text-muted); padding: 0.25rem 0.75rem;">Tools &amp; Theme</div>
            <nav style="display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.25rem;">
                <button type="button" onclick="document.dispatchEvent(new CustomEvent('studio:open'))" style="width: 100%; border: none; background: transparent; cursor: pointer; display: flex; align-items: center; gap: 0.625rem; padding: 0.625rem 0.75rem; border-radius: var(--p-border-radius); text-decoration: none; color: var(--p-text-color); font-weight: 600; font-size: 0.875rem; text-align: left; transition: background 0.15s ease;">
                    <span>🎨</span>
                    <span>Open Theme Studio</span>
                </button>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <main style="flex: 1; min-width: 0;">
            @RenderBody()
        </main>
    </div>

    <!-- Load Islands Bundle -->
    <script type="module" src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

