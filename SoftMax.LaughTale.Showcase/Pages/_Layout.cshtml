<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoftMax.LaughTale</title>
    <!-- Aura-Inspired Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        // Synchronous theme initialization (prevents flash)
        if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body style="margin: 0; padding: 0; background: var(--p-surface-50); color: var(--p-text-color); font-family: var(--p-font-family, sans-serif);">

    <!-- Global Theme Studio Island Drawer -->
    <island-theme-studio />

    <!-- Full-Height App Shell Layout -->
    <div class="app-shell" style="display: flex; min-height: 100vh; width: 100%;">

        <!-- Left Full-Height Sidebar (Sticky Top: 0, 100vh) -->
        <aside class="app-sidebar-dock" style="position: sticky; top: 0; height: 100vh; z-index: 40; flex-shrink: 0;">
            <island-sidebar items="@SoftMax.LaughTale.Showcase.Services.NavigationData.GetGlobalSidebarItems(Context.Request.Path)" title="SoftMax Aura" />
        </aside>

        <!-- Right Main Viewport Area -->
        <div class="app-viewport" style="flex: 1; min-width: 0; display: flex; flex-direction: column; min-height: 100vh;">
            
            <!-- Top App Header Bar -->
            <header class="app-header" style="position: sticky; top: 0; z-index: 30; height: 60px; background: var(--p-surface-0); border-bottom: 1px solid var(--p-border-color); display: flex; align-items: center; justify-content: space-between; padding: 0 1.75rem; box-sizing: border-box;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <span style="font-weight: 700; font-size: 0.9375rem; color: var(--p-text-color);">
                        @ViewData["Title"]
                    </span>
                </div>

                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <!-- Global Theme Studio Trigger Button -->
                    <button type="button" 
                            onclick="document.dispatchEvent(new CustomEvent('studio:open'))" 
                            class="p-button p-button-primary" 
                            style="padding: 0.35rem 0.75rem; font-size: 0.8125rem;">
                        🎨 Studio
                    </button>

                    <!-- Dark Mode Toggle Button -->
                    <button type="button" 
                            onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')" 
                            class="p-button p-button-secondary" 
                            style="padding: 0.35rem 0.65rem; font-size: 0.8125rem;"
                            title="Toggle Dark Mode">
                        🌓
                    </button>

                    <!-- Persistent Island across View Transitions -->
                    <div>
                        <island name="persistent-telemetry" 
                                props="@(new SystemTelemetryProps("API Gateway", 3))" 
                                persist="telemetry-widget" 
                                hydrate="Load" />
                    </div>
                </div>
            </header>

            <!-- Main Page Content Body -->
            <main class="app-main-body" style="flex: 1; padding: 2rem 2.5rem 4rem; width: 100%; box-sizing: border-box; max-width: 1400px; margin: 0 auto;">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Load Islands Bundle -->
    <script type="module" src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


