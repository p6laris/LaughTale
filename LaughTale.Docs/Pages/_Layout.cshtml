@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = currentCulture.TextInfo.IsRightToLeft || currentCulture.Name.StartsWith("ku") || currentCulture.Name.StartsWith("ckb");
}
<!DOCTYPE html>
<html lang="@currentCulture.Name" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaughTale Docs</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg?v=3" />
    <link rel="shortcut icon" href="~/favicon.ico?v=3" />
    <!-- Google Fonts: Geist & Inter (Preloaded non-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"></noscript>
    <link rel="stylesheet" href="~/css/docs.css" asp-append-version="true" />
    <script>
        // Synchronous theme initialization (prevents dark mode flash)
        if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body>
    
    <!-- Top Docs Navbar -->
    <header class="docs-navbar">
        <div class="docs-navbar-inner">
            <div style="display: flex; align-items: center; gap: 2rem;">
                <a href="/" class="brand-group" aria-label="LaughTale Docs Home">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="28" height="28" style="color: var(--p-primary-500); flex-shrink: 0;" fill="currentColor"><path d="M26 14 L42 14 C42 42 62 58 84 58 L84 74 C52 74 26 52 26 14 Z" /><circle cx="34" cy="74" r="6" /></svg>
                    <div>
                        <span class="brand-title">LaughTale</span>
                        <span class="aura-tag tag-slate" style="margin-left: 0.5rem; font-size: 0.6875rem;">Docs v4.0</span>
                    </div>
                </a>
            </div>

            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <!-- Global Search Trigger Button (Ctrl+K) -->
                <button type="button" 
                        onclick="document.dispatchEvent(new CustomEvent('command-palette:open'))" 
                        class="p-button p-button-secondary" 
                        aria-label="Search documentation (Ctrl+K)"
                        style="padding: 0.35rem 0.85rem; font-size: 0.8125rem; display: inline-flex; align-items: center; gap: 0.5rem;"
                        title="Search documentation (Ctrl+K)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <span>Search</span>
                    <kbd style="font-size: 0.6875rem; background: var(--p-surface-200); padding: 0.1rem 0.35rem; border-radius: 4px; border: 1px solid var(--p-border-color);">Ctrl K</kbd>
                </button>

                <!-- Launch Theme Studio Button -->
                <button type="button" 
                        onclick="document.dispatchEvent(new CustomEvent('studio:open'))" 
                        class="p-button p-button-primary" 
                        aria-label="Open Theme Studio"
                        style="direction: ltr; padding: 0.35rem 0.75rem; font-size: 0.8125rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; line-height: 1;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-shrink: 0;"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
                    <span style="display: inline-flex; align-items: center; line-height: 1;">Studio</span>
                </button>

                <!-- Kurdish / Language & RTL Switcher -->
                <button type="button" 
                        onclick="const isKu = document.documentElement.lang.startsWith('ku') || document.documentElement.lang.startsWith('ckb'); const targetLang = isKu ? 'en-US' : 'ku'; const targetDir = isKu ? 'ltr' : 'rtl'; document.documentElement.lang = targetLang; document.documentElement.dir = targetDir; document.cookie = `.AspNetCore.Culture=c=${targetLang}|uic=${targetLang}; path=/; max-age=31536000; SameSite=Lax`; window.location.reload();" 
                        class="p-button p-button-secondary" 
                        aria-label="Toggle Language and Direction"
                        style="direction: ltr; padding: 0.35rem 0.65rem; font-size: 0.8125rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; font-weight: 600; line-height: 1;"
                        title="Toggle Language & RTL (کوردی / English)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                    <span style="display: inline-flex; align-items: center; line-height: 1; font-family: var(--p-font-family, sans-serif);">@(isRtl ? "کوردی" : "EN")</span>
                </button>

                <!-- Dark Mode Toggle Button -->
                <button type="button" 
                        onclick="document.documentElement.classList.toggle('dark'); const isDark = document.documentElement.classList.contains('dark'); document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light'); localStorage.setItem('theme', isDark ? 'dark' : 'light');" 
                        class="p-button p-button-secondary" 
                        aria-label="Toggle Dark Mode"
                        style="padding: 0.35rem 0.65rem; font-size: 0.8125rem; display: inline-flex; align-items: center; justify-content: center; line-height: 1;"
                        title="Toggle Dark Mode">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block; flex-shrink: 0;"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                </button>

                <!-- Persistent Telemetry Island across View Transitions -->
                <island name="persistent-telemetry" 
                        props="@(new SystemTelemetryProps("Docs Gateway", 3))" 
                        persist="docs-telemetry" 
                        hydrate="Load" />
            </div>
        </div>
    </header>

    <!-- Global Theme Studio Island Drawer -->
    <island-theme-studio />

    <!-- Global Command Palette Spotlight Modal (Hidden by Default) -->
    <div id="command-palette-backdrop" class="command-palette-backdrop" style="display: none;">
        <div class="command-palette-modal" onclick="event.stopPropagation()">
            <island-command placeholder="Type a command or search documentation..." model="@DocsNavigationData.GetDocsCommandGroups()" />
        </div>
    </div>

    <!-- Main 3-Column Docs Layout -->
    <div class="docs-layout">
        
        <!-- Left Sidebar Navigation Powered by LaughTale Island Sidebar -->
        <aside class="docs-sidebar" style="padding: 0; border: none; background: transparent; height: calc(100vh - 60px); position: sticky; top: 60px;">
            <island-sidebar items="@DocsNavigationData.GetDocsSidebarItems(Context.Request.Path)" title="LaughTale Docs" />
        </aside>

        <!-- Center Markdown Content Body -->
        <main class="docs-main">
            @RenderBody()
        </main>

        <!-- Right Sticky Table of Contents (TOC) -->
        <aside class="docs-toc">
            @await RenderSectionAsync("Toc", required: false)
        </aside>

    </div>

    <!-- Client Islands Engine Bundle -->
    <script type="module" src="~/js/main.js"></script>
    <script src="~/js/docs-enhancer.js" asp-append-version="true"></script>
</body>
</html>
