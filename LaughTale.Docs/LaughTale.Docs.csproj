<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LaughTale.Docs</AssemblyName>
    <RootNamespace>LaughTale.Docs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaughTale.Core\LaughTale.Core.csproj" />
    <ProjectReference Include="..\LaughTale.Components\LaughTale.Components.csproj" />
    <ProjectReference Include="..\LaughTale.Markdown\LaughTale.Markdown.csproj" />
    <ProjectReference Include="..\LaughTale.Generators\LaughTale.Generators.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Auto-bundle TypeScript islands before build -->
  <Target Name="BuildIslandsJs" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" Condition="Exists('$(ProjectDir)package.json')" />
  </Target>

</Project>
